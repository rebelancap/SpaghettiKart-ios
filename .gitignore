# Pristine upstream — reconstructed by scripts/bootstrap.sh (pin lives there)
/vendor/

# Build trees
/oracle/build-cmake/
/build-ios/
/spikes/*/build*/

# User game data — never committed, never deleted
/work/gamedata/

# Heavy artifacts (screenshots/logs stay small and committed; traces do not)
/artifacts/**/*.trace
/artifacts/**/*.zip
/artifacts/**/*.ipa

.DS_Store

# Sim/device build trees and cross-compiled dep sources
/spikes/
/work/ios-deps/
/work/ios-sim-deps/
/work/vision-deps/
/work/vision-sim-deps/
spikes-build.log
/ota/spaghettikart/*.ipa
/build-visionos/

# Exported release IPAs — staged to the OTA hub, never committed (same rule as
# /artifacts and /ota above). The export plist is generated by the publish run.
/release/
