+// SOH_IOS (overlay 0061, DECISIONS D12 = Shipwright D-084): the PACE PROBE and
+// the REAL-TIME TICK CATCH-UP state. Created by overlay 0061; the source of
+// truth is overlay/assets/SohIosPace.cpp. iOS/visionOS only (the macOS build
+// compiles this file to nothing).
+//
+// Game-thread only: the Metal backend calls the drawable seams from NewFrame,
+// the SDL2 backend the sleep seams from SwapBuffersBegin, and
+// GameEngine::ProcessGfxCommands calls SohIos_PaceTick once per engine frame
+// (MK64: one 30 Hz game frame = two 60 Hz logic ticks, rendered as
+// interpolation_fps / 30 display frames).
+#ifdef __IOS__
+#include <algorithm>
+#include <chrono>
+#include <vector>
+#include <spdlog/spdlog.h>
+#include <libultraship/bridge.h>
+
+extern "C" {
+extern volatile int gSoh3DMode;        // shell: 1 = immersive 3D panel / VR space
+extern volatile int gSohVRWorldActive; // shell: 1 = VR world frames
+int SohIos_PowerState(void);           // shell: 1 LPM, 2 charging, 4 full, 8 unknown
+int SohIos_ThermalState(void);
+}
+
+namespace SohIosPace {
+using Clock = std::chrono::steady_clock;
+Clock::time_point sDrawBegin{}, sDrawEnd{}, sSleepBegin{};
+int sFps = 60; // the current interpolation fps (frame period for the spike probe)
+static bool sHaveDrawEnd = false;
+static std::vector<double> sWait, sBusy, sSleep, sTick;
+static uint32_t sSkipped = 0, sSkipTicks = 0;
+static double sDebtSum = 0.0, sDebtMax = 0.0;
+static Clock::time_point sLastReport = Clock::now();
+static double Ms(Clock::time_point a, Clock::time_point b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+}
+static double Pct(std::vector<double>& v, double p) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    return v[(size_t)(p * (v.size() - 1))];
+}
+static void StressSpin() {
+    // Test instrument (gSohIos.PaceStressMs): a deliberately slow frame.
+    int ms = CVarGetInteger("gSohIos.PaceStressMs", 0);
+    if (ms > 0 && ms < 200) {
+        auto until = Clock::now() + std::chrono::milliseconds(ms);
+        while (Clock::now() < until) {
+        }
+    }
+}
+static void Report(double tickMs) {
+    sTick.push_back(tickMs);
+    auto now = Clock::now();
+    double el = Ms(sLastReport, now) / 1000.0;
+    if (el < 10.0 || sTick.size() < 8) {
+        return;
+    }
+    for (auto* v : { &sWait, &sBusy, &sSleep, &sTick }) {
+        std::sort(v->begin(), v->end());
+    }
+    size_t n = sTick.size();
+    // tick = one ENGINE frame here (30 Hz game frame); tps should read 30.
+    SPDLOG_INFO("SOH_PACE tick_ms p50={:.2f} p95={:.2f} max={:.2f} ticks={} tps={:.2f} frames={} "
+                "wait_ms p50={:.2f} p95={:.2f} max={:.2f} busy_ms p50={:.2f} p95={:.2f} max={:.2f} "
+                "sleep_ms p50={:.2f} p95={:.2f} skipped={} skip_ticks={} debt_avg={:.2f} debt_max={:.2f} "
+                "catchup={} stress={} fps_target={} thermal={} power={}",
+                Pct(sTick, 0.5), Pct(sTick, 0.95), sTick.back(), n, n / el, sBusy.size(), Pct(sWait, 0.5),
+                Pct(sWait, 0.95), sWait.empty() ? 0.0 : sWait.back(), Pct(sBusy, 0.5), Pct(sBusy, 0.95),
+                sBusy.empty() ? 0.0 : sBusy.back(), Pct(sSleep, 0.5), Pct(sSleep, 0.95), sSkipped, sSkipTicks,
+                sDebtSum / n, sDebtMax, CVarGetInteger("gSohIos.TickCatchup", 1),
+                CVarGetInteger("gSohIos.PaceStressMs", 0), sFps, SohIos_ThermalState(), SohIos_PowerState());
+    sWait.clear();
+    sBusy.clear();
+    sSleep.clear();
+    sTick.clear();
+    sSkipped = 0;
+    sSkipTicks = 0;
+    sDebtSum = 0.0;
+    sDebtMax = 0.0;
+    sLastReport = now;
+}
+} // namespace SohIosPace
+
+extern "C" void SohIos_PaceDrawableBegin(void) {
+    SohIosPace::sDrawBegin = SohIosPace::Clock::now();
+}
+extern "C" void SohIos_PaceDrawableEnd(void) {
+    SohIosPace::sDrawEnd = SohIosPace::Clock::now();
+    SohIosPace::sHaveDrawEnd = true;
+    SohIosPace::sWait.push_back(SohIosPace::Ms(SohIosPace::sDrawBegin, SohIosPace::sDrawEnd));
+}
+extern "C" void SohIos_PaceSleepBegin(void) {
+    SohIosPace::StressSpin();
+    SohIosPace::sSleepBegin = SohIosPace::Clock::now();
+    if (SohIosPace::sHaveDrawEnd) {
+        SohIosPace::sBusy.push_back(SohIosPace::Ms(SohIosPace::sDrawEnd, SohIosPace::sSleepBegin));
+        SohIosPace::sHaveDrawEnd = false;
+    }
+}
+extern "C" void SohIos_PaceSleepEnd(void) {
+    SohIosPace::sSleep.push_back(SohIosPace::Ms(SohIosPace::sSleepBegin, SohIosPace::Clock::now()));
+}
+
+// Real-time catch-up (Shipwright D-084). Called once per engine frame with the
+// number of display frames this game frame will render (`count`, the last one
+// being the key frame = real state), the interpolation fps and the game frame
+// rate. Returns how many of the EARLIEST frames to drop: while the game is a
+// frame period or more behind the wall clock, a missed vsync costs a frame
+// instead of stretching the game frame (race clock, kart motion, music
+// sequencing all advance per game frame). Debt is clamped to one game frame;
+// a stall over 250 ms (load, background, menu hitch) resets it, so the game
+// never fast-forwards through a pause. The key frame is never dropped. The
+// immersive modes are left alone (the compositor paces those).
+extern "C" int SohIos_PaceTick(int count, int fps, int gameFps) {
+    using namespace SohIosPace;
+    static Clock::time_point sLastTick{};
+    static double sDebtMs = 0.0;
+    sFps = fps > 0 ? fps : 60;
+    auto now = Clock::now();
+    double tickMs = 1000.0 / (gameFps > 0 ? gameFps : 30);
+    double frameMs = 1000.0 / sFps;
+    double el = 0.0;
+    if (sLastTick.time_since_epoch().count() != 0) {
+        el = Ms(sLastTick, now);
+        if (el > 250.0) {
+            sDebtMs = 0.0; // a stall: never fast-forward through it
+        } else {
+            sDebtMs = std::clamp(sDebtMs + el - tickMs, 0.0, tickMs);
+        }
+    }
+    sLastTick = now;
+    int skip = 0;
+    if (count > 1 && gSoh3DMode == 0 && gSohVRWorldActive == 0 && CVarGetInteger("gSohIos.TickCatchup", 1) != 0) {
+        skip = std::min((int)(sDebtMs / frameMs), count - 1);
+        if (skip > 0) {
+            sSkipped += (uint32_t)skip;
+            sSkipTicks++;
+        }
+    }
+    sDebtSum += sDebtMs;
+    sDebtMax = std::max(sDebtMax, sDebtMs);
+    if (el > 0.0) {
+        Report(el);
+    }
+    return skip;
+}
+#endif
