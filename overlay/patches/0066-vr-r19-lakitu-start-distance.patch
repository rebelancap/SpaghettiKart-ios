+#ifdef __IOS__
+// SOH_IOS (overlay 0066): measure the starter against the camera / kart / eye,
+// and in VR first person move it so the EYE sees it exactly where the flat
+// chase camera does: same offset from the eye as it has from the game camera.
+#define SOHVR_LAKITU_SEAT_UP 3.2f // R18-B's pinned first-person seat height, game units
+// rev2: the two sprite sizes the lift is derived from (game units).
+#define SOHVR_LAKITU_HALF_H (35.0f * 0.15f)  // fixed_common_vtx_lakitu y +-35 at sizeScaling 0.15
+#define SOHVR_KART_SPRITE_Y 18.0f            // gPlayerVtx quad top (y 0..18) before gCharacterSize
+static float SohVRLakituLen(const f32* a, const f32* b) {
+    const float dx = a[0] - b[0], dy = a[1] - b[1], dz = a[2] - b[2];
+    return sqrtf(dx * dx + dy * dy + dz * dz);
+}
+// Bearing of `pt` seen from `from`, against the game camera's look direction
+// (lookAt - pos, horizontal): azimuth + = right, elevation + = up, degrees.
+static void SohVRLakituBearing(const Camera* c, const f32* from, const f32* pt, volatile float* az,
+                               volatile float* el) {
+    const float fx = c->lookAt[0] - c->pos[0], fz = c->lookAt[2] - c->pos[2];
+    const float fl = sqrtf(fx * fx + fz * fz);
+    const float rx = pt[0] - from[0], ry = pt[1] - from[1], rz = pt[2] - from[2];
+    if (fl > 1.0e-4f) {
+        const float fwd = (rx * fx + rz * fz) / fl;
+        const float right = (rx * -fz + rz * fx) / fl;
+        *az = atan2f(right, fwd) * 57.29578f;
+        *el = atan2f(ry, sqrtf(rx * rx + rz * rz)) * 57.29578f;
+    }
+}
+static void SohVRLakituStarter(s32 objectIndex, s32 playerId, s32 cameraId) {
+    if (cameraId < 0) {
+        return;
+    }
+    Object* o = &gObjectList[objectIndex];
+    Player* p = &gPlayers[playerId];
+    Camera* c = &cameras[cameraId];
+    const int live = is_obj_flag_status_active(objectIndex, 0x00000010) != 0;
+    gSohVRLakituTicks++;
+    gSohVRLakituLive = live;
+    gSohVRLakituCamKartD = SohVRLakituLen(c->pos, p->pos);
+    // The flat reference: where the game camera has him, BEFORE any move.
+    gSohVRLakituCamD = SohVRLakituLen(o->pos, c->pos);
+    SohVRLakituBearing(c, c->pos, o->pos, &gSohVRLakituCamAzDeg, &gSohVRLakituCamElDeg);
+    if (live && gSohVRLakituCamD < gSohVRLakituCamDMin) {
+        gSohVRLakituCamDMin = gSohVRLakituCamD;
+    }
+    // VR first person, while he is shown: translate him by (seat - camera), so
+    // (Lakitu - seat) == (Lakitu - camera). The seat (kart + the pinned fp
+    // height), not the live eye: anchoring on the head would make him follow
+    // every head movement.
+    const f32 seat[3] = { p->pos[0], p->pos[1] + SOHVR_LAKITU_SEAT_UP, p->pos[2] };
+    if (gSohVRLakituPush && gSohVRFpWorld && live) {
+        // rev2: seat + k * (Lakitu - camera) + lift. k scales the whole
+        // offset, so the flat azimuth (and the near-zero flat elevation) is
+        // kept; the lift then raises him over the grid (see the header).
+        const float k = gSohVRLakituDistK;
+        for (int i = 0; i < 3; i++) {
+            o->pos[i] = seat[i] + k * (o->pos[i] - c->pos[i]);
+        }
+        o->pos[1] += gSohVRLakituUp;
+        gSohVRLakituPushes++;
     }
+    // rev2: the clearance over the grid row two places ahead, from the seat,
+    // along the game camera's horizontal look direction. Measured in every arm.
+    {
+        const float fx = c->lookAt[0] - c->pos[0], fz = c->lookAt[2] - c->pos[2];
+        const float fl = sqrtf(fx * fx + fz * fz);
+        if (fl > 1.0e-4f) {
+            const float ux = fx / fl, uz = fz / fl;
+            float best[2] = { 1.0e9f, 1.0e9f };
+            int bestI[2] = { -1, -1 };
+            int ahead = 0;
+            for (int i = 0; i < NUM_PLAYERS; i++) {
+                if (i == playerId || (gPlayers[i].type & PLAYER_EXISTS) == 0) {
+                    continue;
+                }
+                const float f = (gPlayers[i].pos[0] - seat[0]) * ux + (gPlayers[i].pos[2] - seat[2]) * uz;
+                if (f <= 1.0f) {
+                    continue;
+                }
+                ahead++;
+                if (f < best[0]) {
+                    best[1] = best[0];
+                    bestI[1] = bestI[0];
+                    best[0] = f;
+                    bestI[0] = i;
+                } else if (f < best[1]) {
+                    best[1] = f;
+                    bestI[1] = i;
+                }
+            }
+            gSohVRLakituAhead = ahead;
+            const float dL = (o->pos[0] - seat[0]) * ux + (o->pos[2] - seat[2]) * uz;
+            gSohVRLakituFwdD = dL;
+            gSohVRLakituBottom = o->pos[1] - SOHVR_LAKITU_HALF_H - seat[1];
+            const int r2 = bestI[1];
+            if (r2 >= 0 && dL > 1.0f) {
+                Player* q = &gPlayers[r2];
+                const float h = SOHVR_KART_SPRITE_Y * gCharacterSize[q->characterId] * q->size;
+                gSohVRLakituRow2D = best[1];
+                gSohVRLakituRow2Top = q->pos[1] - q->boundingBoxSize + h - seat[1];
+                gSohVRLakituRow2Lat = (q->pos[0] - seat[0]) * -uz + (q->pos[2] - seat[2]) * ux;
+                // his bottom, projected to row two's distance, minus that
+                // kart's top: + = he clears it. In sprite heights.
+                gSohVRLakituClearH = (gSohVRLakituBottom * best[1] / dL - gSohVRLakituRow2Top) / h;
+                if (live && gSohVRLakituClearH < gSohVRLakituClearHMin) {
+                    gSohVRLakituClearHMin = gSohVRLakituClearH;
+                }
+            }
+        }
+    }
+    gSohVRLakituKartD = SohVRLakituLen(o->pos, p->pos);
+    if (live && gSohVRLakituKartD < gSohVRLakituKartDMin) {
+        gSohVRLakituKartDMin = gSohVRLakituKartD;
+    }
+    if (gSohVRWorldActive) {
+        const f32 eye[3] = { gSohVREyePosGame[0], gSohVREyePosGame[1], gSohVREyePosGame[2] };
+        gSohVRLakituEyeD = SohVRLakituLen(o->pos, eye);
+        SohVRLakituBearing(c, eye, o->pos, &gSohVRLakituAzDeg, &gSohVRLakituElDeg);
+        if (live && gSohVRLakituEyeD < gSohVRLakituEyeDMin) {
+            gSohVRLakituEyeDMin = gSohVRLakituEyeD;
+        }
+    }
 }
