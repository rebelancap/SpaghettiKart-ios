+
+// SOH_IOS (overlay 0044 rev4, VR R9 item 1): THE RAINBOW FIX.
+//
+// A ping-pong slot may not be re-rendered while the compositor can still
+// be reading it. THREE conditions, all load-bearing:
+//
+//   (a) NOT IN FLIGHT -- the engine's own command buffer for this
+//       framebuffer has completed. Without it the engine can be writing
+//       the texture on its queue while the compositor samples it on
+//       another, with no fence between them.
+//   (b) NOT PUBLISHED -- the texture is not the one the shell's loop is
+//       currently binding. With two slots that means the OTHER slot's
+//       publication has landed, i.e. the engine is at most one frame
+//       ahead of what the headset is actually showing.
+//   (c) NOT IN USE BY THE COMPOSITOR (rev5, VR R11) -- no compositor
+//       command buffer that has ALREADY BEEN ENCODED still references
+//       it. This is the condition rev4 was missing, and it is the whole
+//       of the left-eye artefact. (b) tests the CURRENTLY PUBLISHED
+//       pointer; the compositor, running at 90-100 Hz on its own queue,
+//       reads that pointer into a local, encodes a render pass against
+//       it and commits -- and that buffer can sit queued behind the
+//       engine's own 20 Mpix eye pass for tens of milliseconds. By the
+//       time it executes, publication has moved on, (b) reads false,
+//       and the engine is free to scribble on the exact texture the
+//       compositor is about to sample. rev5 makes the compositor keep a
+//       reference from ENCODE to COMPLETION and the gate waits on it.
+//
+// WHY THE LEFT EYE, AND ONLY THE LEFT EYE. rev4 took every slot's gate
+// at Soh3DSetEye(1) -- the head of the host frame. Eye 0 then writes its
+// slot IMMEDIATELY: zero slack between its gate and its first pixel.
+// Eye 1's write starts a whole eye pass later, so any compositor buffer
+// still holding eye 1's slot has had ~16 ms to drain. Every unfenced
+// read therefore lands on eye 0 -- which is cp_drawable view 0, the LEFT
+// eye. The rate scales with render quality because a heavier eye pass
+// makes the compositor's buffers queue longer behind it, and 50% quality
+// kills most of it because the engine gets there before they drain.
+// rev5 also moves each eye's gate to immediately before ITS OWN pass, so
+// neither gate is answering a question about a slot it is not about to
+// touch.
+//
+// In the steady state neither condition is false here, so the gate costs
+// nothing. It engages exactly when the GPU is behind -- a 20.8 Mpix eye
+// pass at 100% render quality, or a system screenshot briefly seizing the
+// GPU -- which is precisely when the user sees the artefacts. The wait is
+// BOUNDED (trap C1: every wait in this port is) at ~40 ms, a little over
+// one engine frame: if the slot never comes
+// free the frame proceeds anyway and the starve is counted, because a
+// render thread blocked forever is a worse bug than a torn frame.
+int GfxRenderingAPIMetal::Soh3DWaitEyeSlot(int fb, int eyeIdx, int maxSpins) {
+    if (fb < 0 || fb >= (int)mFramebuffers.size() || fb >= SOH3D_MAX_TRACKED_FB) {
+        return 1;
+    }
+    MTL::Texture* sohTex = mTextures[mFramebuffers[fb].mTextureId].texture;
+    const struct timespec sohNap = { 0, 100 * 1000 }; // 0.1 ms
+    int sohWaited = 0;
+    for (int sohSpin = 0; sohSpin <= maxSpins; sohSpin++) { // 400 = ~40 ms ceiling
+        bool sohBusy = sSoh3DInFlight[fb].load(std::memory_order_acquire) > 0;
+        bool sohShown = false;
+        // rev5 condition (c). Counted with the 'shown' bucket: both mean
+        // "the consumer still has it", and splitting them further would
+        // add a device number nobody reads.
+        if (sohTex != nullptr && SohVR_TexInUse((void*)sohTex) != 0) {
+            sohShown = true;
+        }
+        if (sohTex != nullptr && !sohShown) {
+            if (eyeIdx >= 0 && eyeIdx <= 1) {
+                sohShown = ((void*)gSoh3DEyeTexture[eyeIdx] == (void*)sohTex);
+            } else if (eyeIdx == 2) {
+                sohShown = ((void*)gSoh3DHudTexture == (void*)sohTex);
+            } else if (eyeIdx == 3) {
+                sohShown = ((void*)gSoh3DMirrorTexture == (void*)sohTex);
+            }
+        }
+        if (!sohBusy && !sohShown) {
+            if (sohWaited) {
+                gSohIosGfxSlotWaits = gSohIosGfxSlotWaits + 1;
+                gSohIosGfxSlotWaitUs = gSohIosGfxSlotWaitUs + (unsigned)(sohWaited * 100);
+            }
+            // rev6: RESERVE the slot. From here until this
+            // framebuffer's command buffer completes, the compositor
+            // refuses to bind it and shows its last coherent frame
+            // instead. Without this the gate's answer expires the
+            // instant it returns.
+            //
+            // A PROBE MUST NOT RESERVE. maxSpins <= 0 means the caller
+            // is only asking whether this slot is free so it can CHOOSE
+            // one; reserving there overwrites the reservation for the
+            // slot actually being written (one entry per gate) and leaves
+            // stale reservations on candidates that were never used --
+            // measured as 1110 starves and a left eye still missing on
+            // every check.
+            if (maxSpins > 0) {
+                SohVR_TexEngineOwn(eyeIdx, (void*)sohTex);
+            }
+            return 1;
+        }
+        // rev6: a PROBE is not a wait, and must not land in the wait
+        // buckets. The free-slot picker probes every candidate once per
+        // host frame, so counting those made `slot_busy` climb into the
+        // thousands and broke the suite line that reads it ("no wait is
+        // ever for the engine's own GPU work") -- a diagnostic breaking
+        // the instrument reading it, trap D33 again.
+        if (sohWaited == 0 && maxSpins > 0) {
+            if (sohBusy) {
+                gSohIosGfxSlotWaitBusy = gSohIosGfxSlotWaitBusy + 1;
+            } else {
+                gSohIosGfxSlotWaitShown = gSohIosGfxSlotWaitShown + 1;
+            }
+        }
+        sohWaited++;
+        nanosleep(&sohNap, nullptr);
+    }
+    if (maxSpins <= 0) {
+        return 0; // a probe, not a wait: no starve, no reservation
+    }
+    gSohIosGfxSlotStarves = gSohIosGfxSlotStarves + 1;
+    if (eyeIdx >= 0 && eyeIdx < 4) {
+        gSohIosGfxStarveEye[eyeIdx] = gSohIosGfxStarveEye[eyeIdx] + 1;
+    }
+    SPDLOG_WARN("Soh3DWaitEyeSlot: slot {} (eye {}) never came free in 40 ms", fb, eyeIdx);
+    // rev6: the gate timed out but the engine writes the slot anyway,
+    // so the reservation is taken anyway. A consumer that keeps binding
+    // a slot the producer has given up waiting for IS the artefact.
+    SohVR_TexEngineOwn(eyeIdx, (void*)sohTex);
+    return 0;
+}
+
+// SOH_IOS (overlay 0044 rev5, VR R11 item 2): THE RESIZE QUIESCE.
+//
+// Ordering matters and each step exists for a named reason:
+//   1. UNPUBLISH under the publish mutex, tags first. The compositor
+//      reads the tag before it trusts colour+depth, so clearing the tag
+//      first means a loop that is mid-read gets a coherent "nothing
+//      published" rather than a torn pair. Its world blit already skips
+//      a null source (it draws the dim wash and the HUD plane), so a
+//      frame or two of unpublished eyes is a black world, not a crash.
+//   2. WAIT for the engine's own in-flight command buffers, so nothing
+//      is still writing the textures we are about to hand back.
+//   3. WAIT for the COMPOSITOR's claims (R11 item 1's count) to fall to
+//      zero, so no already-encoded compositor buffer still references
+//      them. This is the step that actually stops the crash.
+//   4. DRAIN the retire ring. Those are the only remaining references
+//      besides the framebuffers' own, and holding them across a resize
+//      means the peak is the OLD set plus the NEW one -- 1.6 GB plus
+//      another 1.6 GB at 100% on a headset, which is its own way to die.
+// Every wait is bounded (trap C1). If one times out we proceed anyway:
+// a torn frame beats a render thread parked forever.
+void GfxRenderingAPIMetal::Soh3DQuiesceEyeSlots() {
+    {
+        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+        gSoh3DEyeTag[0] = 0;
+        gSoh3DEyeTag[1] = 0;
+        gSoh3DEyeStamp[0] = 0;
+        gSoh3DEyeStamp[1] = 0;
+        gSoh3DEyeTexture[0] = nullptr;
+        gSoh3DEyeTexture[1] = nullptr;
+        gSoh3DEyeDepthTexture[0] = nullptr;
+        gSoh3DEyeDepthTexture[1] = nullptr;
+        gSoh3DHudTexture = nullptr;
+        gSoh3DMirrorTexture = nullptr;
+        // rev10 (R16-A): a STAGED publication is a reference to an eye
+        // texture this resize is about to release. Drop both (into the
+        // retire ring, which step 4 drains) rather than leaving the
+        // next completion handler to publish a freed texture.
+        for (int sohE = 0; sohE < 2; sohE++) {
+            Soh3DRetireLocked(sSoh3DPendTex[sohE]);
+            Soh3DRetireLocked(sSoh3DPendDepth[sohE]);
+            sSoh3DPendTex[sohE] = nullptr;
+            sSoh3DPendDepth[sohE] = nullptr;
+            sSoh3DPendStamp[sohE] = 0;
+            sSoh3DPendTag[sohE] = 0;
+        }
+    }
+    const struct timespec sohNap = { 0, 500 * 1000 }; // 0.5 ms
+    for (int sohSpin = 0; sohSpin < 400; sohSpin++) { // ~200 ms ceiling
+        bool sohBusy = false;
+        for (int sohFb = 0; sohFb < SOH3D_MAX_TRACKED_FB; sohFb++) {
+            if (sSoh3DInFlight[sohFb].load(std::memory_order_acquire) > 0) {
+                sohBusy = true;
+                break;
+            }
+        }
+        if (!sohBusy) {
+            break;
+        }
+        nanosleep(&sohNap, nullptr);
+    }
+    // rev6: wait for EVERY outstanding claim, not just the ones that
+    // happen to sit in the retire ring. rev5 scanned the ring only --
+    // which does not contain the textures the compositor is binding
+    // RIGHT NOW, the ones this resize is about to release -- and then
+    // called TexInUseClear anyway, telling the gate that live claims
+    // did not exist. Bounded like every other wait (trap C1).
+    for (int sohSpin = 0; sohSpin < 400; sohSpin++) {
+        if (SohVR_TexInUseAny() == 0) {
+            break;
+        }
+        nanosleep(&sohNap, nullptr);
+    }
+    SohVR_TexInUseClear();
+    {
+        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+        for (int sohR = 0; sohR < 16; sohR++) {
+            if (sSoh3DRetired[sohR] != nullptr) {
+                ((MTL::Texture*)sSoh3DRetired[sohR])->release();
+                sSoh3DRetired[sohR] = nullptr;
+            }
+        }
+        sSoh3DRetiredIdx = 0;
+    }
+    gSohIosGfxQuiesces = gSohIosGfxQuiesces + 1;
+    // Log the first few and then shut up. Dragging the render-quality
+    // slider calls this once per notch, and a chatty line here floods
+    // the console bridge's 25-line tail so hard that the suite could no
+    // longer find a single SOH_PERF sample afterwards -- a diagnostic
+    // that breaks the instrument reading it. The COUNTER is the
+    // telemetry (`vr contract` reports quiesces); the log line is only
+    // there to prove the path ran at all.
+    if (gSohIosGfxQuiesces <= 5) {
+        SPDLOG_INFO("Soh3DQuiesceEyeSlots: eye/HUD/mirror attachments unpublished and drained (n={})",
+                    (unsigned)gSohIosGfxQuiesces);
+    }
+}
+
+void GfxRenderingAPIMetal::EndFrameOffscreen() {
+    for (int sohFbId : mDrawnFramebuffers) {
+        auto& sohFb = mFramebuffers[sohFbId];
+        if (sohFb.mCommandBuffer == nullptr) {
+            // SOH_IOS (overlay 0044 rev7, VR R13 item 2a): a framebuffer
+            // that was gated (and therefore RESERVED) but produced no
+            // command buffer will never reach the completion handler that
+            // releases its reservation. Release it here, precisely; the
+            // sweep below is the safety net for the ones that never even
+            // reached mDrawnFramebuffers.
+            SohVR_TexEngineRelease((void*)mTextures[sohFb.mTextureId].texture);
+            continue;
+        }
+        if (!sohFb.mHasEndedEncoding && sohFb.mCommandEncoder != nullptr) {
+            sohFb.mCommandEncoder->endEncoding();
+        }
+        if (!sSohIosPendingMips.empty()) {
+            MTL::BlitCommandEncoder* sohBlit = sohFb.mCommandBuffer->blitCommandEncoder();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohBlit->generateMipmaps(sohTex);
+            }
+            sohBlit->endEncoding();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohTex->release();
+            }
+            sSohIosPendingMips.clear();
+        }
+        // Attach the completion-publish for the requested eye fb — the
+        // compositor must never see a texture whose frame is mid-GPU
+        // (its unfenced cross-queue blit captures every pass EXCEPT the
+        // final one, which holds the ImGui overlay; device-only, the sim
+        // serializes queues).
+        if (sohFbId == sSoh3DPublishFb) {
+            MTL::Texture* sohPubTex = mTextures[sohFb.mTextureId].texture;
+            MTL::Texture* sohPubDepth = sohFb.mDepthTexture;
+            int sohPubEye = sSoh3DPublishEye;
+            uint32_t sohPubTag = sSoh3DPublishTag;
+            // rev6: a NON-ZERO per-eye publish counter (0 is reserved for
+            // "nothing published", which the quiesce writes).
+            uint32_t sohPubStamp = 0;
+            if (sohPubEye >= 0 && sohPubEye <= 1) {
+                sohPubStamp = ++sSoh3DStampSeq[sohPubEye];
+                if (sohPubStamp == 0u) {
+                    sohPubStamp = sSoh3DStampSeq[sohPubEye] = 1u;
+                }
+            }
+            sSoh3DPublishFb = -1;
+            if (sohPubTex != nullptr && sohPubEye >= 0 && sohPubEye <= 1) {
+                // SOH_IOS (overlay 0044 rev5, VR R11 item 1): THE
+                // INDEPENDENT ASSERT. Stamp the pose tag's low byte into
+                // 8 corner texels, IN THE PIXELS, as part of the very
+                // command buffer that renders this eye. The compositor
+                // copies those 8 texels back out at BIND time and compares
+                // them with the tag it read from gSoh3DEyeTag -- two paths
+                // that share nothing (D11): one travels with the image,
+                // one with the CPU-side publication bookkeeping. If the
+                // engine re-enters this slot while the compositor's buffer
+                // is queued, the pixels carry a NEWER tag than the CPU
+                // expected and eye_tag_miss counts up -- on the device,
+                // with no capture tooling and nothing for the user to type.
+                if (gSohVREyeTagOn && sohPubTex->width() >= 8) {
+                    unsigned char sohTagByte = (unsigned char)(sohPubStamp & 0xFFu);
+                    if (gSohVREyeTagFault) {
+                        sohTagByte = (unsigned char)(sohTagByte ^ 0x5Au); // D11 red control
+                    }
+                    MTL::Buffer* sohTagBuf = Soh3DTagBuffer(mDevice, sohTagByte);
+                    if (sohTagBuf != nullptr) {
+                        MTL::BlitCommandEncoder* sohTagBlit =
+                            sohFb.mCommandBuffer->blitCommandEncoder();
+                        sohTagBlit->copyFromBuffer(sohTagBuf, 0, 32, 32, MTL::Size(8, 1, 1),
+                                                   sohPubTex, 0, 0, MTL::Origin(0, 0, 0));
+                        sohTagBlit->endEncoding();
+                    }
+                }
+                sohPubTex->retain();
+                if (sohPubDepth != nullptr) {
+                    sohPubDepth->retain();
+                }
+                sohFb.mCommandBuffer->addCompletedHandler(
+                    MTL::HandlerFunction([sohPubTex, sohPubDepth, sohPubEye,
+                                          sohPubTag, sohPubStamp](MTL::CommandBuffer* sohCb) {
+                        // SOH_IOS (overlay 0044 rev10, VR R16-A): the
+                        // PRODUCER-GAP injection. Dev knob, 0 in every
+                        // shipped configuration (the suite asserts it
+                        // beside staleforce and comphold); eye 0 only,
+                        // because eye 0 is the one that completes first
+                        // and delaying it is what reproduces the
+                        // device's inter-eye publication gap.
+                        if (gSohVREyePubHoldMs > 0 && sohPubEye == 0) {
+                            std::this_thread::sleep_for(
+                                std::chrono::milliseconds(gSohVREyePubHoldMs));
+                        }
+                        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+                        if (!gSohVREyePubAtomic) {
+                            // The 1.0.0.12 protocol, kept as the red
+                            // control: publish this eye the instant it
+                            // completes, whatever the other one is doing.
+                            Soh3DFlushPendLocked(sohPubEye);
+                            Soh3DPublishEyeLocked(sohPubEye, (void*)sohPubTex,
+                                                  (void*)sohPubDepth, sohPubStamp, sohPubTag);
+                            return;
+                        }
+                        // THE ORPHAN BOUND (diagnosis §6). A pair that
+                        // never completes must not freeze the world, so
+                        // a staged publication that is still sitting
+                        // here when the SAME eye publishes again has
+                        // outlived its sibling by a whole host frame:
+                        // release it alone and count it. In the healthy
+                        // case the slot is always empty here, because
+                        // the sibling committed it.
+                        if (sSoh3DPendTex[sohPubEye] != nullptr) {
+                            Soh3DFlushPendLocked(sohPubEye);
+                            gSohVRPubOrphans = gSohVRPubOrphans + 1;
+                        }
+                        sSoh3DPendTex[sohPubEye] = (void*)sohPubTex;
+                        sSoh3DPendDepth[sohPubEye] = (void*)sohPubDepth;
+                        sSoh3DPendStamp[sohPubEye] = sohPubStamp;
+                        sSoh3DPendTag[sohPubEye] = sohPubTag;
+                        if (sSoh3DPendTex[0] != nullptr && sSoh3DPendTex[1] != nullptr) {
+                            if (sSoh3DPendTag[0] == sSoh3DPendTag[1]) {
+                                // BOTH EYES, ONE MOMENT, ONE COMMIT.
+                                // (Equal includes 0 == 0: outside a VR
+                                // world frame there is no pose tag, and
+                                // the two passes of one host frame are
+                                // still the pair to publish together.)
+                                Soh3DFlushPendLocked(0);
+                                Soh3DFlushPendLocked(1);
+                            } else {
+                                // Two different moments staged at once:
+                                // the older one has lost its sibling.
+                                int sohOldEye =
+                                    ((int)(sSoh3DPendTag[1] - sSoh3DPendTag[0]) > 0) ? 0 : 1;
+                                Soh3DFlushPendLocked(sohOldEye);
+                                gSohVRPubOrphans = gSohVRPubOrphans + 1;
+                            }
+                        }
+                    }));
+            }
+        }
+        if (sohFbId == sSoh3DPublishHudFb) {
+            MTL::Texture* sohHudTex = mTextures[sohFb.mTextureId].texture;
+            sSoh3DPublishHudFb = -1;
+            if (sohHudTex != nullptr) {
+                sohHudTex->retain();
+                sohFb.mCommandBuffer->addCompletedHandler(
+                    MTL::HandlerFunction([sohHudTex](MTL::CommandBuffer* sohCb) {
+                        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+                        void* sohOld = (void*)gSoh3DHudTexture;
+                        gSoh3DHudTexture = (void*)sohHudTex;
+                        if (sohOld != nullptr) {
+                            void* sohSlot = sSoh3DRetired[sSoh3DRetiredIdx];
+                            if (sohSlot != nullptr) {
+                                ((MTL::Texture*)sohSlot)->release();
+                            }
+                            sSoh3DRetired[sSoh3DRetiredIdx] = sohOld;
+                            sSoh3DRetiredIdx = (sSoh3DRetiredIdx + 1) % 16;
+                        }
+                    }));
+            }
+        }
+        // SOH_IOS (overlay 0044 rev3, VR R3 / spec D12): the
+        // rear-view pane. Same publish-on-completion contract as the
+        // eyes and the HUD — the compositor blit-copies from its own
+        // queue with no cross-queue fence, so it must never see a
+        // texture whose frame is still mid-GPU.
+        if (sohFbId == sSoh3DPublishMirrorFb) {
+            MTL::Texture* sohMirTex = mTextures[sohFb.mTextureId].texture;
+            sSoh3DPublishMirrorFb = -1;
+            if (sohMirTex != nullptr) {
+                sohMirTex->retain();
+                sohFb.mCommandBuffer->addCompletedHandler(
+                    MTL::HandlerFunction([sohMirTex](MTL::CommandBuffer* sohCb) {
+                        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+                        void* sohOld = (void*)gSoh3DMirrorTexture;
+                        gSoh3DMirrorTexture = (void*)sohMirTex;
+                        if (sohOld != nullptr) {
+                            void* sohSlot = sSoh3DRetired[sSoh3DRetiredIdx];
+                            if (sohSlot != nullptr) {
+                                ((MTL::Texture*)sohSlot)->release();
+                            }
+                            sSoh3DRetired[sSoh3DRetiredIdx] = sohOld;
+                            sSoh3DRetiredIdx = (sSoh3DRetiredIdx + 1) % 16;
+                        }
+                    }));
+            }
+        }
+        // Port delta vs reference: keep the 0027 gpu-ms probe honest in 3D
+        // — same handler as EndFrame's; the frame's LAST completing CB
+        // (the final eye pass) wins the write.
+        sohFb.mCommandBuffer->addCompletedHandler(
+            MTL::HandlerFunction([](MTL::CommandBuffer* sohCb) {
+                double sohMs = (sohCb->GPUEndTime() - sohCb->GPUStartTime()) * 1000.0;
+                if (sohMs > 0 && sohMs < 1000.0) {
+                    gSohIosGpuMs = (float)sohMs;
+                }
+            }));
+        // SOH_IOS (overlay 0044 rev4, VR R9 item 1): the in-flight count
+        // the handoff gate reads. Bumped BEFORE commit -- a completion
+        // handler can fire the instant commit returns.
+        if (sohFbId >= 0 && sohFbId < SOH3D_MAX_TRACKED_FB) {
+            sSoh3DInFlight[sohFbId].fetch_add(1, std::memory_order_release);
+            int sohTrackId = sohFbId;
+            // SOH_IOS (overlay 0044 rev6, VR R12 item 1): release the
+            // reservation the gate took. This is the ONLY place it can
+            // be released, because this is the first moment the GPU is
+            // provably finished writing the texture -- which is the
+            // whole point: rev5's answer expired when Soh3DSetEye
+            // returned, a host frame too early for eye 0.
+            MTL::Texture* sohOwnTex = mTextures[sohFb.mTextureId].texture;
+            sohFb.mCommandBuffer->addCompletedHandler(
+                MTL::HandlerFunction([sohTrackId, sohOwnTex](MTL::CommandBuffer* sohCb) {
+                    if (sohOwnTex != nullptr) {
+                        SohVR_TexEngineRelease((void*)sohOwnTex);
+                    }
+                    sSoh3DInFlight[sohTrackId].fetch_sub(1, std::memory_order_release);
+                }));
+        }
+        sohFb.mCommandBuffer->commit();
+    }
+    mDrawnFramebuffers.clear();
