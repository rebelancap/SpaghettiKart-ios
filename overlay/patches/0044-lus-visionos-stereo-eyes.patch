+
+// SOH_IOS (overlay 0044 rev6, VR R12 item 1): THE PRODUCER'S BACKPRESSURE.
+//
+// Every wait in this port is bounded (trap C1) and this one ended by
+// WRITING ANYWAY, so whenever the consumer held a slot for longer than the
+// 40 ms ceiling the producer stomped it -- and the consumer holds EYE 0
+// longest, because the compositor claims eye 0 first and releases every
+// claim together when its command buffer completes. Measured: with the
+// read window widened to 150 ms the LEFT eye missed 100% of its frame
+// checks and the right 13%.
+//
+// The answer is not a longer wait, it is not writing at all. This probes
+// every candidate slot without blocking; if none is free the caller skips
+// the whole host frame's eye work and the compositor keeps showing the
+// publication it already holds -- a repeated frame instead of a torn one,
+// which is what a consumer at 90-100 Hz should see from a 30 Hz producer.
+// D16 called a gate on too few buffers "quantising the producer onto the
+// consumer's period"; with three slots and honest backpressure that is the
+// CORRECT behaviour rather than a bug.
+int Interpreter::Soh3DPickSlot() {
+    mSoh3DPickedSlot = -1;
+    if (mSoh3DEyeFb[0][0] < 0) {
+        return 0; // nothing allocated yet: the first frame creates them
+    }
+    for (int sohK = 1; sohK <= 3; sohK++) {
+        int sohCand = (mSoh3DPing + sohK) % 3;
+        if (mSoh3DEyeFb[0][sohCand] < 0 || mSoh3DEyeFb[1][sohCand] < 0) {
+            continue;
+        }
+        if (mRapi->Soh3DWaitEyeSlot(mSoh3DEyeFb[0][sohCand], 0, 0) &&
+            mRapi->Soh3DWaitEyeSlot(mSoh3DEyeFb[1][sohCand], 1, 0) &&
+            (mSoh3DHudFb[sohCand] < 0 ||
+             mRapi->Soh3DWaitEyeSlot(mSoh3DHudFb[sohCand], 2, 0))) {
+            mSoh3DPickedSlot = sohCand;
+            gSohIosGfxSlotPicks = gSohIosGfxSlotPicks + 1;
+            return sohCand;
+        }
+    }
+    gSohIosGfxSlotPickFails = gSohIosGfxSlotPickFails + 1;
+    return -1;
+}
+
+int Interpreter::Soh3DGetEyeFb(int eye) {
+    return (eye >= 1 && eye <= 2) ? mSoh3DEyeFb[eye - 1][mSoh3DPing] : -1;
+}
+
+int Interpreter::Soh3DGetHudFb() {
+    return mSoh3DHudFb[mSoh3DPing];
+}
+
+// SOH_IOS (overlay 0044, VR / spec D6): switch the DRAW TARGET between
+// the eye framebuffer and the HUD framebuffer mid-display-list. Upstream
+// already owns the recipe for a mid-list target switch
+// (gfx_reset_fb_handler_custom): flush the pending batch, re-point the
+// backend, then force viewport and scissor to reapply against the new
+// target — which is also trap B4's rule for passes of differing size.
+// SOH_IOS (overlay 0044 rev3, VR R3): which framebuffer the 2D stretch of
+// the display list goes to. The eye passes use the HUD framebuffer, which
+// the shell composites as a plane; the rear-view pane's pass uses a SINK
+// nobody ever reads — by the time it runs the HUD framebuffer has already
+// been published, and it is sized to the eye extent, so mirror-pass
+// texrects (built in SCREEN space against mCurDimensions) would land in it
+// at the wrong scale.
+int Interpreter::Soh3DGetMirrorFb() {
+    return mSoh3DMirrorFb[mSoh3DPing];
+}
+
+static int Soh3DVRHudFbFor(int sohEye, int sohHudFb, int sohSinkFb) {
+    // SOH_IOS (overlay 0044 rev12, VR R16-C step 5): the own-kart span is
+    // the first diversion that runs in the EYE walks rather than the pane's,
+    // and the eyes' usual sink is the HUD framebuffer -- which is
+    // COMPOSITED. Parking a kart there would draw it over the HUD instead
+    // of hiding it, so that span goes to the mirror sink, which nobody
+    // reads. (The sink only exists while the pane is up, which is also the
+    // only condition under which 0054 rev4 emits the span.)
+    return (sohEye == 3 || Soh3DOwnKartSink()) ? sohSinkFb : sohHudFb;
+}
+
+void Interpreter::Soh3DVRTarget(bool hud) {
+    const int sohHudFb = Soh3DVRHudFbFor(sSoh3DEye, mSoh3DHudFb[mSoh3DPing], mSoh3DMirrorSinkFb);
+    if (!gSohVRWorldActive || sSoh3DEye == 0 || sohHudFb < 0) {
+        return;
+    }
+    if (hud == mSoh3DHudActive) {
+        return;
+    }
+    Flush();
+    mSoh3DHudActive = hud;
+    mRapi->StartDrawToFramebuffer(hud ? sohHudFb : mGameFb,
+                                  (float)mCurDimensions.height / mNativeDimensions.height);
+    mRdp->viewport_or_scissor_changed = true;
+    mRenderingState.viewport = {};
+    mRenderingState.scissor = {};
+}
+
+void Interpreter::Soh3DVRClearHud() {
+    const int sohHudFb = Soh3DVRHudFbFor(sSoh3DEye, mSoh3DHudFb[mSoh3DPing], mSoh3DMirrorSinkFb);
+    if (sohHudFb < 0) {
+        return;
+    }
+    Flush();
+    mSoh3DHudActive = true;
+    mRapi->StartDrawToFramebuffer(sohHudFb, (float)mCurDimensions.height / mNativeDimensions.height);
+    mRapi->ClearFramebuffer(true, true);
+    mRdp->viewport_or_scissor_changed = true;
+    mRenderingState.viewport = {};
+    mRenderingState.scissor = {};
+}
+
+void Interpreter::Soh3DEndEyePass(int eye) {
+    // Publish ON GPU COMPLETION, never at commit — the compositor
+    // blit-copies the published texture from its own queue with no
+    // cross-queue fence, and a mid-frame capture contains every pass EXCEPT
+    // the final one (which holds the ImGui overlay): game visible, menu
+    // never. Device-only: the simulator serializes queues.
+    if (eye >= 1 && eye <= 2 && mSoh3DEyeFb[eye - 1][mSoh3DPing] >= 0) {
+        mRapi->Soh3DPublishOnComplete(mSoh3DEyeFb[eye - 1][mSoh3DPing], eye - 1, sSohVRTag);
+    }
+    // SOH_IOS (overlay 0044 rev3, VR R3 / spec D12): the rear-view pane
+    // publishes on the same completion contract, and hands mCurDimensions
+    // back to the EYE extent before anything else can observe the mirror
+    // size (see StartFrame's note — alternating extents would re-resize
+    // every game framebuffer twice per host frame).
+    if (eye == 3) {
+        if (mSoh3DMirrorFb[mSoh3DPing] >= 0) {
+            mRapi->Soh3DPublishMirrorOnComplete(mSoh3DMirrorFb[mSoh3DPing]);
+        }
+        if (mSoh3DEyeDimsW > 0) {
+            mCurDimensions.width = mSoh3DEyeDimsW;
+            mCurDimensions.height = mSoh3DEyeDimsH;
+            mCurDimensions.aspect_ratio = (float)mSoh3DEyeDimsW / (float)mSoh3DEyeDimsH;
+        }
+    }
+    // VR: both eye passes render the same HUD content into the same
+    // framebuffer (it is wiped at the head of each); publish once, after
+    // the second pass, so the plane compositor never samples a half-drawn
+    // HUD (spec D6).
+    if (gSohVRWorldActive && eye == 2 && mSoh3DHudFb[mSoh3DPing] >= 0) {
+        Soh3DVRTarget(false);
+        mRapi->Soh3DPublishHudOnComplete(mSoh3DHudFb[mSoh3DPing]);
+    }
+    mRapi->EndFrameOffscreen();
+    mRapi->FinishRender();
+    if (eye >= 1 && eye <= 2) {
+        gSoh3DEyeFrames[eye - 1] = gSoh3DEyeFrames[eye - 1] + 1;
+    }
+}
