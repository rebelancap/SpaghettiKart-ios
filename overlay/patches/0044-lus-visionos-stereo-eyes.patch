@@ -1116,6 +1116,731 @@
 void GfxRenderingAPIMetal::FinishRender() {
 }
 
+#ifdef __IOS__
+// SOH_IOS (overlay 0044): end-of-eye-pass flush for stereoscopic 3D. The
+// screen framebuffer was never set up this frame (no drawable — a hidden
+// window's acquire stalls), so EndFrame's present path is unusable: commit
+// every drawn framebuffer's command buffer, ride 0021's pending-mip pass on
+// the last one, and replicate EndFrame's per-frame state cleanup. The
+// upstream fb-0 deferred-readback machinery is deliberately NOT serviced
+// here (dormant in 3D — see the patch header).
+extern "C" {
+extern void* volatile gSoh3DEyeTexture[2];
+// SOH_IOS (overlay 0044, VR): the eye's DEPTH texture and the pose
+// frame id it was rendered against, published by the same handler and
+// therefore always consistent with the colour texture.
+extern void* volatile gSoh3DEyeDepthTexture[2];
+extern volatile unsigned int gSoh3DEyeTag[2];
+// SOH_IOS (overlay 0044 rev6, VR R12 item 1): the frame-tag probe's
+// STAMP id, which is NOT the pose tag. rev5 stamped the pose tag, and
+// the pose tag only changes when the COMPOSITOR publishes a new pose --
+// so any condition that slows the compositor (which is every condition
+// this bug lives in, and every stress that reproduces it) makes the
+// engine re-render the slot with the SAME byte and the probe reads a
+// perfect match through a real tear. Measured: 150 ms of induced
+// compositor delay, zero misses, on the protocol that is known broken.
+// The stamp is a per-eye publish counter instead: it changes on every
+// single eye pass, so overwriting a slot ALWAYS changes the pixels the
+// probe reads (trap D30 amended -- the value that rides the bytes must
+// change as often as the bytes do).
+extern volatile unsigned int gSoh3DEyeStamp[2];
+extern void* volatile gSoh3DHudTexture;
+extern void* volatile gSoh3DMirrorTexture;
+extern volatile int gSohVRWorldActive;
+extern volatile int gSohVRDbgClearsAll, gSohVRDbgClearsAlpha;
+// SOH_IOS (overlay 0044 rev10, VR R16-A): the eye pair's PUBLICATION.
+//   gSohVREyePubHoldMs -- the producer-gap injection. On device the two
+//     eye passes are separate command buffers executed serially by the
+//     GPU, so eye 1 completes roughly one eye pass (~10 ms) after eye 0
+//     and the compositor spends a large fraction of every host frame
+//     looking at a MISMATCHED pair. In the simulator the passes are
+//     cheap and the gap is microseconds, which is why every split
+//     number this arc has produced was measured in a regime the device
+//     never enters. This holds eye 0's publication back by <ms> so the
+//     simulator can be put in the device's regime on demand.
+//   gSohVREyePubAtomic / gSohVRPubOrphans -- rev10's own fix and its
+//     bound (see the staging block in the publish handler).
+extern volatile int gSohVREyePubHoldMs;
+extern volatile int gSohVREyePubAtomic;
+extern volatile unsigned int gSohVRPubOrphans;
+}
+// SOH_IOS (overlay 0044 rev4, VR R9 item 1): the handoff bookkeeping.
+//   sSoh3DInFlight -- per framebuffer, how many of its own command
+//     buffers are committed and not yet complete. Bumped at commit,
+//     dropped in a completion handler, so it is an honest "the GPU still
+//     owns this texture" rather than a guess from timings.
+//   The counters below are what `vr contract` reports back off the
+//     device at the moment the artefacts appear.
+#define SOH3D_MAX_TRACKED_FB 64
+static std::atomic<int> sSoh3DInFlight[SOH3D_MAX_TRACKED_FB];
+extern "C" {
+volatile unsigned int gSohIosGfxSlotWaits = 0;      // gate engaged
+volatile unsigned int gSohIosGfxSlotStarves = 0;    // gate timed out
+// Split so the gate's COST can be attributed rather than guessed at:
+// (a) the slot's own command buffer is still on the GPU, versus (b) the
+// compositor is still bound to it. They have different fixes.
+volatile unsigned int gSohIosGfxSlotWaitBusy = 0;
+volatile unsigned int gSohIosGfxSlotWaitShown = 0;
+volatile unsigned int gSohIosGfxSlotWaitUs = 0;     // total, microseconds
+// rev6 (R12): did the producer FIND a free slot to write, or did it fall
+// back to rotate-and-wait? A fallback is the only way a starve can
+// happen, and a starve is the producer stomping the consumer.
+volatile unsigned int gSohIosGfxSlotPicks = 0;
+volatile unsigned int gSohIosGfxSlotPickFails = 0;
+volatile unsigned int gSohIosGfxSlotSkips = 0;    // eye passes skipped, not stomped
+volatile unsigned int gSohIosGfxStarveEye[4] = { 0, 0, 0, 0 };
+}
+// SOH_IOS (overlay 0044 rev5, VR R11 item 1): THE LEFT-EYE FIX and its
+// independent instrument. Both symbols are DEFINED IN THE SHELL
+// (SohIosShell.m) because the compositor owns them; the engine only
+// reads them, which is what keeps the assert non-tautological (D11).
+//   SohVR_TexInUse  -- non-zero while a COMPOSITOR command buffer that
+//     has already been encoded still references this texture. The
+//     published-pointer test below cannot see those: the compositor
+//     reads gSoh3DEyeTexture[e] into a local, encodes a pass against it
+//     and commits; that buffer may not execute for tens of ms.
+//   gSohVREyeTagOn / gSohVREyeTagFault -- the corner frame-tag probe and
+//     its deliberate-fault control (D11's discriminating-power clause).
+// SOH_IOS (overlay 0044 rev6, VR R12 item 1): THE OTHER HALF.
+//   SohVR_TexEngineOwn -- the PRODUCER's reservation, the mirror image
+//     of the consumer's claim. rev5 asked the compositor's question at
+//     the moment Soh3DSetEye runs, but that is where the eye pass is
+//     ENCODED, not where it is WRITTEN: every eye framebuffer commits
+//     together at the end of the host frame. Eye 0's gate is therefore
+//     answered a whole host frame before its pixels land and eye 1's
+//     half a frame before -- three compositor frames of exposure versus
+//     one and a half, which is why the survivor of rev5 was still the
+//     LEFT eye (trap D29 one level further out). Marking the slot owned
+//     at the gate and clearing it on completion makes the answer hold
+//     until the write is actually done, for both eyes equally.
+//   SohVR_TexInUseAny -- every outstanding claim, for the quiesce.
+extern "C" {
+int SohVR_TexInUse(void* tex);
+int SohVR_TexInUseAny(void);
+void SohVR_TexEngineOwn(int slot, void* tex);
+void SohVR_TexEngineRelease(void* tex);
+// SOH_IOS (overlay 0044 rev7, VR R13 item 2a): the reservation SWEEP.
+// A reservation is taken at the gate and released only by the drawn
+// framebuffer's completion handler -- so a framebuffer that is gated
+// and then NOT DRAWN (one gSohVRWorldActive flip between the gate and
+// Interpreter::Run is enough) leaks its slot forever, and from the
+// moment that texture becomes the published HUD the compositor's claim
+// is refused on every frame and the HUD never draws again. Called once
+// per host frame; ages each live reservation and drops the stale ones.
+void SohVR_TexEngineSweep(void);
+void SohVR_TexInUseClear(void);
+volatile unsigned int gSohIosGfxQuiesces = 0;   // rev5: resize quiesces
+extern volatile int gSohVREyeTagOn;
+extern volatile int gSohVREyeTagFault;
+}
+// The tag strip is 8 texels of pure black or pure white in the top-left
+// corner of the eye texture, carrying the low 8 bits of the pose tag the
+// eye was rendered against. Black/white because the eye textures are
+// sRGB: 0 and 255 are the only two byte values that survive an sRGB
+// round trip exactly. One immutable 32-byte buffer per possible value
+// (8 KB total, built lazily) so no staging buffer is ever rewritten
+// while the GPU is reading it.
+static MTL::Buffer* sSoh3DTagBuf[256];
+static MTL::Buffer* Soh3DTagBuffer(MTL::Device* dev, unsigned char v) {
+    if (sSoh3DTagBuf[v] == nullptr) {
+        unsigned char px[32];
+        for (int i = 0; i < 8; i++) {
+            unsigned char lvl = ((v >> i) & 1) ? 0xFF : 0x00;
+            px[i * 4 + 0] = lvl;
+            px[i * 4 + 1] = lvl;
+            px[i * 4 + 2] = lvl;
+            px[i * 4 + 3] = 0xFF;
+        }
+        sSoh3DTagBuf[v] = dev->newBuffer(px, sizeof(px), MTL::ResourceStorageModeShared);
+    }
+    return sSoh3DTagBuf[v];
+}
+static int sSoh3DPublishFb = -1;
+static int sSoh3DPublishEye = -1;
+static uint32_t sSoh3DPublishTag = 0;
+static uint32_t sSoh3DStampSeq[2] = { 0, 0 }; // rev6: per-eye publish counter
+static int sSoh3DPublishHudFb = -1;
+static int sSoh3DPublishMirrorFb = -1;
+static std::mutex sSoh3DPublishMutex;
+static void* sSoh3DRetired[16];
+static int sSoh3DRetiredIdx = 0;
+// SOH_IOS (overlay 0044 rev10, VR R16-A / F2): THE PAIR IS PUBLISHED
+// ATOMICALLY. Each eye pass is its own command buffer and its own
+// completion handler, so until rev10 the two eyes' (texture, depth,
+// stamp, tag) triples became visible INDEPENDENTLY -- and on device the
+// gap between them is a whole eye pass (~10 ms out of a ~40 ms host
+// frame), during which every compositor frame sees a mismatched pair
+// and has to take the last-good fallback. R15's pair rule hid that at
+// the consumer; this removes it at the producer, which is where it is.
+// A publication is STAGED here and committed only when its sibling
+// holds the same pose tag; then pair_splits, pair_forced and
+// present_splits are structurally zero rather than merely small.
+static void* sSoh3DPendTex[2] = { nullptr, nullptr };
+static void* sSoh3DPendDepth[2] = { nullptr, nullptr };
+static uint32_t sSoh3DPendStamp[2] = { 0, 0 };
+static uint32_t sSoh3DPendTag[2] = { 0, 0 };
+// Retire a texture the published globals no longer point at. Caller
+// holds sSoh3DPublishMutex.
+static void Soh3DRetireLocked(void* sohT) {
+    if (sohT == nullptr) {
+        return;
+    }
+    void* sohSlot = sSoh3DRetired[sSoh3DRetiredIdx];
+    if (sohSlot != nullptr) {
+        ((MTL::Texture*)sohSlot)->release();
+    }
+    sSoh3DRetired[sSoh3DRetiredIdx] = sohT;
+    sSoh3DRetiredIdx = (sSoh3DRetiredIdx + 1) % 16;
+}
+// Publish one eye. Colour and depth first, stamp next, TAG LAST: the
+// compositor reads the tag before it trusts the rest. Caller holds the
+// mutex.
+static void Soh3DPublishEyeLocked(int sohEye, void* sohTex, void* sohDepth, uint32_t sohStamp,
+                                  uint32_t sohTag) {
+    void* sohOld = (void*)gSoh3DEyeTexture[sohEye];
+    void* sohOldD = (void*)gSoh3DEyeDepthTexture[sohEye];
+    gSoh3DEyeTexture[sohEye] = sohTex;
+    gSoh3DEyeDepthTexture[sohEye] = sohDepth;
+    gSoh3DEyeStamp[sohEye] = sohStamp;
+    gSoh3DEyeTag[sohEye] = sohTag;
+    Soh3DRetireLocked(sohOld);
+    Soh3DRetireLocked(sohOldD);
+}
+static void Soh3DFlushPendLocked(int sohEye) {
+    if (sSoh3DPendTex[sohEye] == nullptr) {
+        return;
+    }
+    Soh3DPublishEyeLocked(sohEye, sSoh3DPendTex[sohEye], sSoh3DPendDepth[sohEye],
+                          sSoh3DPendStamp[sohEye], sSoh3DPendTag[sohEye]);
+    sSoh3DPendTex[sohEye] = nullptr;
+    sSoh3DPendDepth[sohEye] = nullptr;
+    sSoh3DPendStamp[sohEye] = 0;
+    sSoh3DPendTag[sohEye] = 0;
+}
+static std::set<int> sSoh3DTransparentFbs;
