+    sohPF[1] /= sohPd;
+    sohPF[2] /= sohPd;
+    float sohPR[3] = { sohPF[1] * sohUp[2] - sohPF[2] * sohUp[1],
+                       sohPF[2] * sohUp[0] - sohPF[0] * sohUp[2],
+                       sohPF[0] * sohUp[1] - sohPF[1] * sohUp[0] };
