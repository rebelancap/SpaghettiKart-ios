+        int sohGot = 0;
+        for (int sohT = 0; sohT < 4; sohT++) {
+            const unsigned int sohS0 = gSohVRKartSeq;
+            if (sohS0 & 1u) {
+                continue;
+            }
+            __sync_synchronize();
+            for (int sohI = 0; sohI < 3; sohI++) {
