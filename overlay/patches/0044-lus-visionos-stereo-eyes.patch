+    const float sohGU[3] = { sohGR[1] * sohGF[2] - sohGR[2] * sohGF[1],
+                             sohGR[2] * sohGF[0] - sohGR[0] * sohGF[2],
+                             sohGR[0] * sohGF[1] - sohGR[1] * sohGF[0] };
