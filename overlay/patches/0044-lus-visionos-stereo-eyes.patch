+    sohPR[1] /= sohPrl;
+    sohPR[2] /= sohPrl;
+    const float sohPU[3] = { sohPR[1] * sohPF[2] - sohPR[2] * sohPF[1],
+                             sohPR[2] * sohPF[0] - sohPR[0] * sohPF[2],
+                             sohPR[0] * sohPF[1] - sohPR[1] * sohPF[0] };
