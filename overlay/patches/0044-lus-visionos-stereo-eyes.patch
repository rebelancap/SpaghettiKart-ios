+        if (sohL < 1.0e-4f) {
+            return 0;
+        }
+        for (int sohI = 0; sohI < 3; sohI++) {
+            sohAx[sohC][sohI] = sohV[sohI] / sohL;
+        }
+        sohD[sohC] = -in[3][sohJ] / sohL;
+    }
+    for (int sohI = 0; sohI < 3; sohI++) {
+        sohOut[sohI] = sohD[0] * sohAx[0][sohI] + sohD[1] * sohAx[1][sohI] + sohD[2] * sohAx[2][sohI];
+    }
+    return 1;
+}
+// The walk loads the projection TWICE: guPerspective alone (G_MTX_LOAD)
+// and then guLookAt multiplied onto it (G_MTX_MUL). Both are perspective
+// matrices and this function sees both, so the FIRST one is the bare
+// frustum with the camera at the origin -- which is what a first cut of
+// this probe sampled, and it read key_err = 163.77 = |camEye| exactly.
+// So every perspective load of the walk goes into a PENDING slot and the
+// last one wins, committed at the head of the next walk.
+static int sSohVRGhostPending = 0;
+static float sSohVRGhostPendRel[3] = { 0.0f, 0.0f, 0.0f };
+static float sSohVRGhostPendT = 1.0f;
+static float sSohVRGhostPendKey = -1.0f;
+static float sSohVRGhostRel[3] = { 0.0f, 0.0f, 0.0f };
+static float sSohVRGhostD[3] = { 0.0f, 0.0f, 0.0f };
+static int sSohVRGhostHave = 0;
+static double sSohVRGhostJAcc = 0.0, sSohVRGhostSAcc = 0.0;
+static unsigned int sSohVRGhostCount = 0;
+// extern "C": this TU is inside namespace Fast, and the shell calls it.
+extern "C" void Soh3DGhostReset(void) {
+    sSohVRGhostHave = 0;
+    sSohVRGhostPending = 0;
+    sSohVRGhostJAcc = sSohVRGhostSAcc = 0.0;
+    sSohVRGhostCount = 0;
+    gSohVRGhostN = 0;
+    gSohVRGhostJitter = gSohVRGhostJitterMax = gSohVRGhostStep = 0.0f;
+    gSohVRGhostTMin = 9.0f;
+    gSohVRGhostTMax = -9.0f;
+    gSohVRGhostKeyErr = -1.0f;
+    gSohVRGhostKeyN = 0;
+    gSohVRSeatDeltaMax = 0.0f; // rev14
+    gSohVRSeatDxMax = 0.0f;
+}
+static void Soh3DGhostSample(const float in[4][4]) {
+    float sohE[3];
+    if (!Soh3DRecoverCamEye(in, sohE)) {
+        return;
+    }
+    float sohT = gSohVRWalkT;
+    if (!(sohT > 0.0f && sohT <= 1.0f)) {
+        sohT = 1.0f;
+    }
+    // The key-frame walk must recover the very camera position 0045
+    // exported this game frame. If it does not, either t is not what this
+    // code thinks it is or the recovery is wrong -- and the whole
+    // measurement is void. It is reported, not assumed.
+    if (sohT > 0.999f) {
+        const float sohKx = sohE[0] - gSoh3DCamEye[0];
+        const float sohKy = sohE[1] - gSoh3DCamEye[1];
+        const float sohKz = sohE[2] - gSoh3DCamEye[2];
+        sSohVRGhostPendKey = sqrtf(sohKx * sohKx + sohKy * sohKy + sohKz * sohKz);
+    }
+    // The SEAT'S BASE as this walk actually used it: 0045's live export
+    // plus whatever correction Soh3DSeatLerp applied (0 in the red arm).
+    // The seat's constant offsets do not appear because a constant cannot
+    // contribute to a difference, let alone a second one.
+    float sohBase[3], sohDelta[3];
+    if (!Soh3DSeatBase(sohBase, sohDelta)) {
+        return;
+    }
+    const float sohW = 1.0f - sohT;
+    const float sohSeat[3] = {
+        sohBase[0] + (gSohVRSeatInterp ? sohDelta[0] * sohW : 0.0f),
+        sohBase[1] + (gSohVRSeatInterp ? sohDelta[1] * sohW : 0.0f),
+        sohBase[2] + (gSohVRSeatInterp ? sohDelta[2] * sohW : 0.0f),
+    };
+    for (int sohI = 0; sohI < 3; sohI++) {
+        sSohVRGhostPendRel[sohI] = sohE[sohI] - sohSeat[sohI];
+    }
+    sSohVRGhostPendT = sohT;
+    sSohVRGhostPending = 1;
+}
+// Commit the walk that just finished: its LAST perspective load is the
+// combined view*projection, and that is the one the world was drawn with.
+static void Soh3DGhostCommit(void) {
+    if (!sSohVRGhostPending) {
+        return;
+    }
+    sSohVRGhostPending = 0;
+    const float* sohRel = sSohVRGhostPendRel;
+    const float sohT = sSohVRGhostPendT;
+    if (sohT < gSohVRGhostTMin) {
+        gSohVRGhostTMin = sohT;
+    }
+    if (sohT > gSohVRGhostTMax) {
+        gSohVRGhostTMax = sohT;
+    }
+    if (sSohVRGhostPendKey >= 0.0f) {
+        gSohVRGhostKeyErr = sSohVRGhostPendKey;
+        gSohVRGhostKeyN = gSohVRGhostKeyN + 1;
+        sSohVRGhostPendKey = -1.0f;
+    }
+    if (sSohVRGhostHave >= 1) {
+        float sohDd[3];
+        double sohStep = 0.0;
+        for (int sohI = 0; sohI < 3; sohI++) {
+            sohDd[sohI] = sohRel[sohI] - sSohVRGhostRel[sohI];
+            sohStep += (double)sohDd[sohI] * (double)sohDd[sohI];
+        }
+        sohStep = sqrt(sohStep);
+        if (sSohVRGhostHave >= 2) {
+            double sohJ = 0.0;
+            for (int sohI = 0; sohI < 3; sohI++) {
+                const double sohJi = (double)sohDd[sohI] - (double)sSohVRGhostD[sohI];
+                sohJ += sohJi * sohJi;
+            }
+            sohJ = sqrt(sohJ);
+            sSohVRGhostJAcc += sohJ;
+            sSohVRGhostSAcc += sohStep;
+            sSohVRGhostCount = sSohVRGhostCount + 1;
+            if ((float)sohJ > gSohVRGhostJitterMax) {
+                gSohVRGhostJitterMax = (float)sohJ;
+            }
+            gSohVRGhostN = sSohVRGhostCount;
+            gSohVRGhostJitter = (float)(sSohVRGhostJAcc / (double)sSohVRGhostCount);
+            gSohVRGhostStep = (float)(sSohVRGhostSAcc / (double)sSohVRGhostCount);
+        }
+        for (int sohI = 0; sohI < 3; sohI++) {
+            sSohVRGhostD[sohI] = sohDd[sohI];
+        }
+        sSohVRGhostHave = 2;
+    } else {
+        sSohVRGhostHave = 1;
+    }
+    for (int sohI = 0; sohI < 3; sohI++) {
+        sSohVRGhostRel[sohI] = sohRel[sohI];
+    }
+}
+// ---------------------------------------------------------------------------
+// SOH_IOS (overlay 0044 rev15, VR R18-A): THE CLASS PROBE (dev only).
+//
+// R17-A's ghost probe compares the interpolated GAME camera with a MODEL of
+// the seat (the game-thread export plus the correction) -- it never looks at
+// the eye matrix the walk was actually drawn with, so a matrix composed
+// around a different base than the model assumes is invisible to it (trap
+// D11: the instrument shared the assumption under test). This one reads
+// both ends off what the renderer is handed:
+//   * the EYE position recovered from the composed eye matrix itself (eye 1,
+//     after every correction) -- the point that maps to x = y = w = 0, a
+//     3x3 solve that holds for any perspective matrix, off-axis included;
+//   * each object CLASS's drawn world translation: row 3 of the modelview
+//     the interpreter actually loaded (FrameInterpolation's replacement
+//     included), for the first load inside a G_NOOP 0x70 ... 0x71 bracket
+//     the game emits only while gSohVRClassProbe is set (0054 rev6, 0065).
+// Per class it reports
+//   jit/jitmax  |second difference| of (drawn - eye) across consecutive walks:
+//               zero for anything moving at constant velocity relative to the
+//               eye, one seat step for something on a different clock.
+//   dev/devmax  |drawn - lerp(prev key, cur key, t)| on the non-key walks:
+//               is the class on its OWN interpolation clock? For the eye this
+//               is the stale-base detector.
+//   interp/tick loads that found / did not find a FrameInterpolation
+//               replacement on a non-key walk.
+//   dup         a second load for the same key inside one walk (a DUPLICATE).
+//   back        walks on which a kart quad's local +z faced AWAY from the eye
+//               (G_CULL_BACK territory -- a flash OFF, trap D19), and facemin
+//               the smallest cosine seen.
+#define SOHVR_CP_NCLS 8
+#define SOHVR_CP_NENT 160
+#define SOHVR_CP_NBUF 8
+static const char* const kSohCpName[SOHVR_CP_NCLS] = {
+    "eye", "ownshadow", "ownkart", "ownboost", "ownpart", "kart", "shadow", "part",
+};
+struct SohCpEnt {
+    int used, cls, key;
+    int seen, hit;
+    float d[3], n[3];
+    int relN;
+    float rel[3], d1[3];
+    unsigned int lastWalk;
+    int bufN;
+    float bufT[SOHVR_CP_NBUF];
+    float bufD[SOHVR_CP_NBUF][3];
+    int haveKey;
+    unsigned int keyIdx;
+    float keyP[3];
+};
+struct SohCpStat {
+    unsigned int n, devN, stepN, interp, tick, dup, back, loads;
+    double jAcc, devAcc, stepAcc;
+    float jMax, devMax, faceMin, faceMax;
+};
+static SohCpEnt sSohCp[SOHVR_CP_NENT];
+static SohCpStat sSohCpStat[SOHVR_CP_NCLS];
+static int sSohCpPendCls = -1, sSohCpPendKey = 0;
+static int sSohCpEyeHave = 0;
+static float sSohCpEye[3] = { 0.0f, 0.0f, 0.0f };
+static float sSohCpT = 1.0f;
+static unsigned int sSohCpWalk = 0, sSohCpKeyIdx = 0, sSohCpFull = 0;
+static float sSohCpTMin = 9.0f, sSohCpTMax = -9.0f;
+// rev16 (R21 item 2): classprobe 1 samples eye 1 (R18-A); classprobe 2 samples
+// the REAR PANE's walk (eye index 3) instead, with the eye recovered from the
+// pane's own composed matrix. One table, one walk at a time.
+static int Soh3DCpEyeIdx(void) {
+    return (gSohVRClassProbe == 2) ? 3 : 1;
+}
+extern "C" void Soh3DClassReset(void) {
+    memset(sSohCp, 0, sizeof(sSohCp));
+    memset(sSohCpStat, 0, sizeof(sSohCpStat));
+    for (int sohC = 0; sohC < SOHVR_CP_NCLS; sohC++) {
+        sSohCpStat[sohC].faceMin = 2.0f;
+        sSohCpStat[sohC].faceMax = -2.0f;
+    }
+    sSohCpPendCls = -1;
+    sSohCpEyeHave = 0;
+    sSohCpWalk = sSohCpKeyIdx = sSohCpFull = 0;
+    sSohCpTMin = 9.0f;
+    sSohCpTMax = -9.0f;
+    gSohVRBaseWalks = gSohVRBaseStale = gSohVRSeatRebases = 0;
+    gSohVRBaseErrMax = gSohVRBaseErrAcc = 0.0f;
+}
+static SohCpEnt* Soh3DClassFind(int sohCls, int sohKey) {
+    SohCpEnt* sohFree = nullptr;
+    for (int sohI = 0; sohI < SOHVR_CP_NENT; sohI++) {
+        SohCpEnt* sohE = &sSohCp[sohI];
+        if (sohE->used) {
+            if (sohE->cls == sohCls && sohE->key == sohKey) {
+                return sohE;
+            }
+        } else if (sohFree == nullptr) {
+            sohFree = sohE;
+        }
+    }
+    if (sohFree == nullptr) {
+        sSohCpFull = sSohCpFull + 1;
+        return nullptr;
+    }
+    memset(sohFree, 0, sizeof(*sohFree));
+    sohFree->used = 1;
+    sohFree->cls = sohCls;
+    sohFree->key = sohKey;
+    return sohFree;
+}
+// The eye of a projective matrix (row vectors, clip = p*M): the one world
+// point with clip x = y = w = 0.
+static int Soh3DEyeFromMatrix(const float m[4][4], float sohE[3]) {
+    const int sohCol[3] = { 0, 1, 3 };
+    double sohA[3][3], sohB[3];
+    for (int sohR = 0; sohR < 3; sohR++) {
+        for (int sohI = 0; sohI < 3; sohI++) {
+            sohA[sohR][sohI] = m[sohI][sohCol[sohR]];
+        }
+        sohB[sohR] = -(double)m[3][sohCol[sohR]];
+    }
+    const double sohDet = sohA[0][0] * (sohA[1][1] * sohA[2][2] - sohA[1][2] * sohA[2][1]) -
+                          sohA[0][1] * (sohA[1][0] * sohA[2][2] - sohA[1][2] * sohA[2][0]) +
+                          sohA[0][2] * (sohA[1][0] * sohA[2][1] - sohA[1][1] * sohA[2][0]);
+    if (fabs(sohDet) < 1.0e-12) {
+        return 0;
+    }
+    for (int sohK = 0; sohK < 3; sohK++) {
+        double sohM[3][3];
+        for (int sohR = 0; sohR < 3; sohR++) {
+            for (int sohI = 0; sohI < 3; sohI++) {
+                sohM[sohR][sohI] = (sohI == sohK) ? sohB[sohR] : sohA[sohR][sohI];
+            }
+        }
+        const double sohDk = sohM[0][0] * (sohM[1][1] * sohM[2][2] - sohM[1][2] * sohM[2][1]) -
+                             sohM[0][1] * (sohM[1][0] * sohM[2][2] - sohM[1][2] * sohM[2][0]) +
+                             sohM[0][2] * (sohM[1][0] * sohM[2][1] - sohM[1][1] * sohM[2][0]);
+        sohE[sohK] = (float)(sohDk / sohDet);
+    }
+    return 1;
+}
+// Eye 1's composed matrix, after every correction this pass applies.
+static void Soh3DClassEye(const float out[4][4]) {
+    float sohE[3];
+    if (!Soh3DEyeFromMatrix(out, sohE)) {
+        return;
+    }
+    float sohT = gSohVRWalkT;
+    if (!(sohT > 0.0f && sohT <= 1.0f)) {
+        sohT = 1.0f;
+    }
+    sSohCpEye[0] = sohE[0];
+    sSohCpEye[1] = sohE[1];
+    sSohCpEye[2] = sohE[2];
+    sSohCpT = sohT;
+    sSohCpEyeHave = 1;
+}
+// The first modelview load inside a class bracket.
+static void Soh3DClassSample(const float mv[4][4], int sohHit) {
+    const int sohCls = sSohCpPendCls;
+    const int sohKey = sSohCpPendKey;
+    sSohCpPendCls = -1;
+    if (sohCls < 0 || sohCls >= SOHVR_CP_NCLS) {
+        return;
+    }
+    SohCpEnt* sohE = Soh3DClassFind(sohCls, sohKey);
+    if (sohE == nullptr) {
+        return;
+    }
+    SohCpStat* sohS = &sSohCpStat[sohCls];
+    sohS->loads = sohS->loads + 1;
+    sohE->seen = sohE->seen + 1;
+    if (sohE->seen > 1) {
+        sohS->dup = sohS->dup + 1;
+        return;
+    }
+    for (int sohI = 0; sohI < 3; sohI++) {
+        sohE->d[sohI] = mv[3][sohI];
+        sohE->n[sohI] = mv[2][sohI];
+    }
+    sohE->hit = sohHit;
+}
+// Commit the walk that just ended (called with Soh3DGhostCommit, at the head
+// of the next walk's eye 1, before the new snapshot is latched).
+static void Soh3DClassCommit(void) {
+    if (!sSohCpEyeHave) {
+        for (int sohI = 0; sohI < SOHVR_CP_NENT; sohI++) {
+            sSohCp[sohI].seen = 0;
+        }
+        return;
+    }
+    sSohCpEyeHave = 0;
+    const float sohT = sSohCpT;
+    const int sohIsKey = (sohT > 0.999f);
+    const unsigned int sohWalk = ++sSohCpWalk;
+    const unsigned int sohKeyNow = sohIsKey ? ++sSohCpKeyIdx : sSohCpKeyIdx;
+    if (sohT < sSohCpTMin) {
+        sSohCpTMin = sohT;
+    }
+    if (sohT > sSohCpTMax) {
+        sSohCpTMax = sohT;
+    }
+    SohCpEnt* sohEye = Soh3DClassFind(0, 0);
+    if (sohEye != nullptr) {
+        sohEye->seen = 1;
+        sohEye->hit = 0;
+        for (int sohI = 0; sohI < 3; sohI++) {
+            sohEye->d[sohI] = sSohCpEye[sohI];
+            sohEye->n[sohI] = 0.0f;
+        }
+    }
+    for (int sohX = 0; sohX < SOHVR_CP_NENT; sohX++) {
+        SohCpEnt* sohE = &sSohCp[sohX];
+        if (!sohE->used) {
+            continue;
+        }
+        if (sohE->seen == 0) {
+            sohE->relN = 0; // a missed walk breaks the difference chain
+            continue;
+        }
+        SohCpStat* sohS = &sSohCpStat[sohE->cls];
+        if (sohE->cls != 0) {
+            if (!sohIsKey) {
+                if (sohE->hit) {
+                    sohS->interp = sohS->interp + 1;
+                } else {
+                    sohS->tick = sohS->tick + 1;
+                }
+            }
+            float sohRel[3];
+            for (int sohI = 0; sohI < 3; sohI++) {
+                sohRel[sohI] = sohE->d[sohI] - sSohCpEye[sohI];
+            }
+            if (sohE->relN >= 1 && sohE->lastWalk + 1 == sohWalk) {
+                float sohD1[3];
+                for (int sohI = 0; sohI < 3; sohI++) {
+                    sohD1[sohI] = sohRel[sohI] - sohE->rel[sohI];
+                }
+                if (sohE->relN >= 2) {
+                    double sohJ = 0.0;
+                    for (int sohI = 0; sohI < 3; sohI++) {
+                        const double sohJi = (double)sohD1[sohI] - (double)sohE->d1[sohI];
+                        sohJ += sohJi * sohJi;
+                    }
+                    sohJ = sqrt(sohJ);
+                    sohS->jAcc += sohJ;
+                    sohS->n = sohS->n + 1;
+                    if ((float)sohJ > sohS->jMax) {
+                        sohS->jMax = (float)sohJ;
+                    }
+                }
+                for (int sohI = 0; sohI < 3; sohI++) {
+                    sohE->d1[sohI] = sohD1[sohI];
+                }
+                sohE->relN = sohE->relN + 1;
+            } else {
+                sohE->relN = 1;
+            }
+            for (int sohI = 0; sohI < 3; sohI++) {
+                sohE->rel[sohI] = sohRel[sohI];
+            }
+            if (sohE->cls == 2 || sohE->cls == 5) {
+                // The kart quad's local +z against the direction to the eye.
+                const float sohNl = sqrtf(sohE->n[0] * sohE->n[0] + sohE->n[1] * sohE->n[1] +
+                                          sohE->n[2] * sohE->n[2]);
+                const float sohDl = sqrtf(sohRel[0] * sohRel[0] + sohRel[1] * sohRel[1] +
+                                          sohRel[2] * sohRel[2]);
+                if (sohNl > 1.0e-4f && sohDl > 1.0e-4f) {
+                    const float sohF = -(sohE->n[0] * sohRel[0] + sohE->n[1] * sohRel[1] +
+                                         sohE->n[2] * sohRel[2]) / (sohNl * sohDl);
+                    if (sohF < sohS->faceMin) {
+                        sohS->faceMin = sohF;
+                    }
+                    if (sohF > sohS->faceMax) {
+                        sohS->faceMax = sohF;
+                    }
+                    if (sohF < 0.0f) {
+                        sohS->back = sohS->back + 1;
+                    }
+                }
+            }
+        }
+        // expected(t): the class's own lerp between its key-walk positions.
+        if (!sohIsKey) {
+            if (sohE->bufN < SOHVR_CP_NBUF) {
+                sohE->bufT[sohE->bufN] = sohT;
+                for (int sohI = 0; sohI < 3; sohI++) {
+                    sohE->bufD[sohE->bufN][sohI] = sohE->d[sohI];
+                }
+                sohE->bufN = sohE->bufN + 1;
+            }
+        } else {
+            if (sohE->haveKey && sohE->keyIdx + 1 == sohKeyNow) {
+                double sohStep = 0.0;
+                for (int sohI = 0; sohI < 3; sohI++) {
+                    const double sohSi = (double)sohE->d[sohI] - (double)sohE->keyP[sohI];
+                    sohStep += sohSi * sohSi;
+                }
+                sohS->stepAcc += sqrt(sohStep);
+                sohS->stepN = sohS->stepN + 1;
+                for (int sohB = 0; sohB < sohE->bufN; sohB++) {
+                    const float sohBt = sohE->bufT[sohB];
+                    double sohDev = 0.0;
+                    for (int sohI = 0; sohI < 3; sohI++) {
+                        const double sohX = (double)sohE->keyP[sohI] +
+                                            ((double)sohE->d[sohI] - (double)sohE->keyP[sohI]) * sohBt;
+                        const double sohDi = (double)sohE->bufD[sohB][sohI] - sohX;
+                        sohDev += sohDi * sohDi;
+                    }
+                    sohDev = sqrt(sohDev);
+                    sohS->devAcc += sohDev;
+                    sohS->devN = sohS->devN + 1;
+                    if ((float)sohDev > sohS->devMax) {
+                        sohS->devMax = (float)sohDev;
+                    }
+                }
+            }
+            for (int sohI = 0; sohI < 3; sohI++) {
+                sohE->keyP[sohI] = sohE->d[sohI];
+            }
+            sohE->keyIdx = sohKeyNow;
+            sohE->haveKey = 1;
+            sohE->bufN = 0;
+        }
+        sohE->lastWalk = sohWalk;
+        sohE->seen = 0;
+    }
+}
+// `vr classes`: name=n,jit,jitmax,dev,devmax,step,interp,tick,dup,back,facemin,facemax
+static char sSohCpLine[1536];
+extern "C" const char* Soh3DClassDump(void) {
+    int sohN = snprintf(sSohCpLine, sizeof(sSohCpLine), "cp_walks=%u cp_keys=%u cp_t=%.3f,%.3f cp_full=%u",
+                        sSohCpWalk, sSohCpKeyIdx, sSohCpTMin, sSohCpTMax, sSohCpFull);
+    for (int sohC = 0; sohC < SOHVR_CP_NCLS && sohN > 0 && sohN < (int)sizeof(sSohCpLine); sohC++) {
+        const SohCpStat* sohS = &sSohCpStat[sohC];
+        sohN += snprintf(sSohCpLine + sohN, sizeof(sSohCpLine) - (size_t)sohN,
+                         " %s=%u,%.4f,%.4f,%.4f,%.4f,%.4f,%u,%u,%u,%u,%.3f,%.3f", kSohCpName[sohC], sohS->n,
+                         sohS->n ? sohS->jAcc / (double)sohS->n : 0.0, sohS->jMax,
+                         sohS->devN ? sohS->devAcc / (double)sohS->devN : 0.0, sohS->devMax,
+                         sohS->stepN ? sohS->stepAcc / (double)sohS->stepN : 0.0, sohS->interp, sohS->tick,
+                         sohS->dup, sohS->back, (sohS->faceMin > 1.5f) ? 9.0f : sohS->faceMin,
+                         (sohS->faceMax < -1.5f) ? -9.0f : sohS->faceMax);
