+        sohVi[0][sohJ] = sohGR[sohJ];
+        sohVi[1][sohJ] = sohGU[sohJ];
+        sohVi[2][sohJ] = sohGF[sohJ];
+        sohVi[3][sohJ] = sohGE[sohJ];
+    }
+    sohVi[0][3] = sohVi[1][3] = sohVi[2][3] = 0.0f;
+    sohVi[3][3] = 1.0f;
