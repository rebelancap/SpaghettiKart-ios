+// T = V_pane * V_game^-1, the rigid transform that takes the GAME's view
+// to the PANE's. Trap D32: correct in the MATRIX, never in the list. It
+// generalises the 180-degree mirror the pane used to pre-multiply -- with
+// V_pane = M * V_game this returns exactly M -- and it carries no
+// handedness assumption: if the game's real lookAt matrix is V_mine * S
+// for any fixed S (a flipped third axis, say), the S cancels, because both
+// sides of the product are built from the same construction.
+static int Soh3DBuildPaneT(float sohT[4][4], const float sohP[3], const float sohA[3],
+                           const float sohUp[3]) {
+    const float sohGR[3] = { gSoh3DCamRight[0], gSoh3DCamRight[1], gSoh3DCamRight[2] };
+    const float sohGF[3] = { gSoh3DCamFwd[0], gSoh3DCamFwd[1], gSoh3DCamFwd[2] };
+    const float sohGE[3] = { gSoh3DCamEye[0], gSoh3DCamEye[1], gSoh3DCamEye[2] };
+    const float sohFl = sohGF[0] * sohGF[0] + sohGF[1] * sohGF[1] + sohGF[2] * sohGF[2];
+    const float sohRl = sohGR[0] * sohGR[0] + sohGR[1] * sohGR[1] + sohGR[2] * sohGR[2];
+    if (sohFl < 0.9f || sohFl > 1.1f || sohRl < 0.9f || sohRl > 1.1f) {
+        return 0; // no usable game basis this frame
