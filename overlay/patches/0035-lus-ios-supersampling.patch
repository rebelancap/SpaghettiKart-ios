+#ifdef __IOS__
+// SOH_IOS (overlay 0036): SSAA hooks provided by the app shell (SohIosShell.m).
+extern "C" float SohIos_SsaaFactor(void);
+extern "C" uint32_t SohIos_DrawablePixelWidth(void);
+// Verification telemetry (bridge `drawable` prints cur=WxH; must equal
+// native x ssaa). File-scope extern "C" — the wave-2 trap: block-scope
+// externs namespace-mangle.
+extern "C" {
+extern volatile int gSoh3DDbgCurW, gSoh3DDbgCurH;
+// rev2: 3D-session flag (shell-owned, defined on every platform) — gates
+// the SSAA scale off while stereo is active (see the block comment below).
+extern volatile int gSoh3DMode;
+}
+#endif
