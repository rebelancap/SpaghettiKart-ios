+#ifdef __IOS__
+#include <math.h>
+// SOH_IOS (overlay 0058, VR R13 item 3): the gradient CAP quads. See the patch
+// header — 0044 rev7 pitches the sky's ortho projection, and without these the
+// quad's own top and bottom edges come into view as soon as it moves.
+extern "C" {
+extern volatile int gSohVRWorldActive;
+extern volatile int gSohVRSkyMode;
+// SOH_IOS (overlay 0058, VR R13 item 3): the game's own horizon, in the sky's
+// 320x240 ortho pixels. It is the ONE pitch quantity MK64 computes (every
+// cloud's Y is derived from it), and nothing exported it, so the sky's
+// vertical placement had no telemetry at all. `vr mode` reports it next to the
+// composed eye's pitch, which is what the shift is the difference of.
+extern volatile int gSohVRSkyCamHeight;
+// SOH_IOS (overlay 0058 rev4, VR R17-A item 3): the LATERAL caps and their
+// controls. gSohVRSkyWide is the A/B (0 = 1.0.0.13, no side caps, the RED
+// CONTROL); gSohVRSkyArFault forces the aspect the gradient's own edges are
+// computed at, in MILLI-units (1246 = the Vision Pro's 1.246), so this
+// simulator -- whose eye is 1.778 and therefore OVERHANGS -- can reproduce the
+// device's black strips at all; 0 = off, which is every shipped configuration.
+// The three telemetry values say where the gradient's edges actually landed
+// and what aspect they were built at, which is the whole diagnosis as numbers.
+extern volatile int gSohVRSkyWide;
+extern volatile int gSohVRSkyArFault;
+extern volatile int gSohVRSkyVtxL, gSohVRSkyVtxR;
+extern volatile float gSohVRSkyBuildAr;
+extern volatile unsigned int gSohVRSkySideQuads;
+// SOH_IOS (overlay 0058 rev5, VR R17-B): the DOME's projection swap. See
+// DrawSkyActors below and overlay 0051 rev7.
+extern volatile int gSohVRSkyDome;
+extern volatile int gSohVREyeKey;
+extern volatile float gSohVRSkyDomeR;
+extern volatile unsigned int gSohVRSkyDomeFrames;
+void set_matrix_hud_screen(void);
+}
+#define SOH_IOS_SKY_CAP_EXT 2400
+static Vtx sSohIosSkyCap[8];
+// Four quads per side (sky, upper cap, floor, lower cap), 4 vertices each,
+// LEFT side first. Index within a quad follows the game's own convention for
+// these screen quads: 0 = top-right, 1 = bottom-right, 2 = bottom-left,
+// 3 = top-left, drawn as gSP2Triangles(0,3,1, 0, 1,3,2).
+#define SOH_IOS_SKY_SIDE_QUADS 8
+static Vtx sSohIosSkySide[SOH_IOS_SKY_SIDE_QUADS * 4];
+static void soh_ios_sky_side_quad(s32 sohQ, const Vtx* sohTopSrc, const Vtx* sohBotSrc, s16 sohXr,
+                                  s16 sohXl, s16 sohYt, s16 sohYb) {
+    Vtx* sohV = &sSohIosSkySide[sohQ * 4];
+    const Vtx* sohSrc[4] = { sohTopSrc, sohBotSrc, sohBotSrc, sohTopSrc };
+    const s16 sohX[4] = { sohXr, sohXr, sohXl, sohXl };
+    const s16 sohY[4] = { sohYt, sohYb, sohYb, sohYt };
+    for (s32 sohI = 0; sohI < 4; sohI++) {
+        sohV[sohI].v.flag = 0;
+        sohV[sohI].v.tc[0] = 0;
+        sohV[sohI].v.tc[1] = 0;
+        sohV[sohI].v.ob[0] = sohX[sohI];
+        sohV[sohI].v.ob[1] = sohY[sohI];
+        sohV[sohI].v.ob[2] = -1;
+        for (s32 sohC = 0; sohC < 4; sohC++) {
+            sohV[sohI].v.cn[sohC] = sohSrc[sohI]->v.cn[sohC];
+        }
+    }
+}
+// vtx layout, from the static initialisers above:
+//   [0] top-right   [1] horizon-right [2] horizon-left [3] top-left
+//   [4] floor-top-r [5] floor-bot-r   [6] floor-bot-l  [7] floor-top-l
+// Quads 0-3 are the LEFT side (x from L-EXT to L), 4-7 the RIGHT (R to R+EXT).
+static void soh_ios_sky_sides(Vtx* vtx, s16 sohCamH) {
+    const s16 sohL = vtx[2].v.ob[0];
+    const s16 sohR = vtx[1].v.ob[0];
+    const s16 sohLo = (s16)(-SOH_IOS_SKY_CAP_EXT);
+    const s16 sohHi = (s16)(SCREEN_HEIGHT + SOH_IOS_SKY_CAP_EXT);
+    const s16 sohXll = (s16)(sohL - SOH_IOS_SKY_CAP_EXT);
+    const s16 sohXrr = (s16)(sohR + SOH_IOS_SKY_CAP_EXT);
+    // LEFT: everything continues the left-hand column of the gradient.
+    soh_ios_sky_side_quad(0, &vtx[3], &vtx[2], sohL, sohXll, SCREEN_HEIGHT, sohCamH);
+    soh_ios_sky_side_quad(1, &vtx[3], &vtx[3], sohL, sohXll, sohHi, SCREEN_HEIGHT);
+    soh_ios_sky_side_quad(2, &vtx[7], &vtx[6], sohL, sohXll, sohCamH, 0);
+    soh_ios_sky_side_quad(3, &vtx[6], &vtx[6], sohL, sohXll, 0, sohLo);
+    // RIGHT: the right-hand column.
+    soh_ios_sky_side_quad(4, &vtx[0], &vtx[1], sohXrr, sohR, SCREEN_HEIGHT, sohCamH);
+    soh_ios_sky_side_quad(5, &vtx[0], &vtx[0], sohXrr, sohR, sohHi, SCREEN_HEIGHT);
+    soh_ios_sky_side_quad(6, &vtx[4], &vtx[5], sohXrr, sohR, sohCamH, 0);
+    soh_ios_sky_side_quad(7, &vtx[5], &vtx[5], sohXrr, sohR, 0, sohLo);
+}
+static void soh_ios_sky_caps(Vtx* vtx) {
+    // Above the gradient: continue the TOP edge upward to the zenith. Below the
+    // floor: continue the floor's far edge downward. Each cap vertex copies the
+    // gradient vertex it sits directly above (right corners from vtx[0]/vtx[5],
+    // left corners from vtx[3]/vtx[6]), so the join carries no seam even on a
+    // course whose TopLeft and TopRight differ. Both keep the
+    // widescreen-corrected x the game just computed, and the same winding as
+    // the quads they extend.
+    const s16 sohL = vtx[2].v.ob[0];
+    const s16 sohR = vtx[1].v.ob[0];
+    const s16 sohTop = SCREEN_HEIGHT;
+    const s16 sohHi = (s16)(SCREEN_HEIGHT + SOH_IOS_SKY_CAP_EXT);
+    const s16 sohLo = (s16)(-SOH_IOS_SKY_CAP_EXT);
+    // cap vertex -> the gradient vertex whose colour it continues.
+    static const s32 sohSrcIdx[8] = { 0, 0, 3, 3, 5, 5, 6, 6 };
+    for (s32 sohI = 0; sohI < 8; sohI++) {
+        const Vtx* sohSrc = &vtx[sohSrcIdx[sohI]];
+        sSohIosSkyCap[sohI].v.flag = 0;
+        sSohIosSkyCap[sohI].v.tc[0] = 0;
+        sSohIosSkyCap[sohI].v.tc[1] = 0;
+        sSohIosSkyCap[sohI].v.ob[2] = -1;
+        for (s32 sohC = 0; sohC < 4; sohC++) {
+            sSohIosSkyCap[sohI].v.cn[sohC] = sohSrc->v.cn[sohC];
+        }
+    }
+    sSohIosSkyCap[0].v.ob[0] = sohR;  sSohIosSkyCap[0].v.ob[1] = sohHi;
+    sSohIosSkyCap[1].v.ob[0] = sohR;  sSohIosSkyCap[1].v.ob[1] = sohTop;
+    sSohIosSkyCap[2].v.ob[0] = sohL;  sSohIosSkyCap[2].v.ob[1] = sohTop;
+    sSohIosSkyCap[3].v.ob[0] = sohL;  sSohIosSkyCap[3].v.ob[1] = sohHi;
+    sSohIosSkyCap[4].v.ob[0] = sohR;  sSohIosSkyCap[4].v.ob[1] = 0;
+    sSohIosSkyCap[5].v.ob[0] = sohR;  sSohIosSkyCap[5].v.ob[1] = sohLo;
+    sSohIosSkyCap[6].v.ob[0] = sohL;  sSohIosSkyCap[6].v.ob[1] = sohLo;
+    sSohIosSkyCap[7].v.ob[0] = sohL;  sSohIosSkyCap[7].v.ob[1] = 0;
+}
+#endif
