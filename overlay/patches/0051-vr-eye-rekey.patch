+    }
+    const float sohTanH = tanf(sohFovY * (float)(M_PI / 360.0));
+    const float sohNdcC = 1.0f - (2.0f * (float)(sohArg0 - sohMY)) / 240.0f;
+    const float sohNdcH = 1.0f - (2.0f * (float)sohCamH) / 240.0f;
+    const float sohEl = atanf(sohNdcC * sohTanH) - atanf(sohNdcH * sohTanH);
+    const short sohAzBam = (short)(-(int)(short)(unsigned short)sohRotY);
+    const float sohAz = (float)sohAzBam * (float)(M_PI / 32768.0);
+    if (!(fabsf(sohEl) < SOH_IOS_SKY_DOME_MAXEL) || !isfinite(sohEl)) {
+        return 0;
+    }
