+// into 65526 and 65529 -- sprites the flat game also never shows, because
+// its warp guard skips them off the bottom of the screen).
+static int soh_ios_sky_dir(s32 sohRotY, s32 sohMY, s32 sohArg0, s32 sohCamH, f32 sohFovDeg,
+                           float sohDir[3], float* sohAzOut, float* sohElOut, float* sohTanOut) {
+    float sohFovY = sohFovDeg;
