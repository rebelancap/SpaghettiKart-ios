+// 0 P .. 9 I (see above). Out-of-order marks void the frame.
+extern "C" void SohIos_MenuMark(int which) {
+    using namespace SohIosMenu;
+    if (!gSohIosSpkOn || gSoh3DMode != 0 || which < 0 || which >= NMARK) {
+        sNext = 0;
+        return;
+    }
+    if (which == 0) {
+        sNext = 0;
+        sTopWin = nullptr;
+        sTopWinMs = 0.0;
+    } else if (which != sNext) {
+        sNext = 0;
+        return;
+    }
+    sT[which] = Clock::now();
+    sC[which] = clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID);
+    sNext = which + 1;
+    if (which == NMARK - 1) {
+        sNext = 0;
+        Finish();
+    }
+}
