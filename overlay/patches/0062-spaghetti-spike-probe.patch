+// SOH_IOS (overlay 0062, DECISIONS D13 = Shipwright D-085 + D-087, overlays
+// 0066 + 0068): the SPIKE ATTRIBUTION PROBE and the MENU-PHASE SPLIT. Created
+// by overlay 0062; the source of truth is overlay/assets/SohIosSpike.cpp.
+// iOS/visionOS only (the macOS build compiles this file to nothing).
+//
+// Game-thread state (the game loop owns the main thread on iOS), except the
+// resource pool threads' ledger, which is mutex-guarded. Reads overlay 0061's
+// pace timestamps (SohIosPace, src/port/SohIosPace.cpp) for the drawable and
+// sleep seams. Output lines (formats identical to Shipwright's, so the same
+// readers work): SOH_SPIKE / SOH_SPKWIN (0066) and SOH_MSLOW / SOH_MENUWIN
+// (0068). gSohIos.SpikeProbe (default 1) switches both off.
+#ifdef __IOS__
+#include <algorithm>
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <time.h>
+#include <spdlog/spdlog.h>
+#include <libultraship/bridge.h>
+
+extern "C" {
+extern volatile int gSoh3DMode;
+int SohIos_ThermalState(void);
+volatile int gSohIosSpkOn = 1;
+unsigned int gSohIosSpkTris = 0;
+unsigned int gSohIosSpkVtx = 0;
+unsigned int gSohIosSpkDraws = 0;
+}
+
+namespace SohIosPace { // overlay 0061 (SohIosPace.cpp)
+using Clock = std::chrono::steady_clock;
+extern Clock::time_point sDrawBegin, sDrawEnd, sSleepBegin;
+extern int sFps;
+} // namespace SohIosPace
+
+namespace SohIosSpk {
+using Clock = std::chrono::steady_clock;
+// Category indices match Shipwright's 0066 so one reader parses every port.
+// Not wired on MK64 (never non-zero): rd (the split needs the archive read
+// apart from the parse, and 0029 owns that span), up (inside tex), zdep/zpso
+// (MK64 never calls GetPixelDepth -- D14), actor/obj/room (no OoT spawn path).
+enum { NCAT = 17 };
+static const char* const kName[NCAT] = { "res",  "rd",    "bg",  "rwait", "tex",    "up",  "shd", "zdep",  "zpso",
+                                         "fbrd", "actor", "obj", "room",  "cvsave", "aud", "ev",  "interp" };
+enum { S_GAP, S_WAIT, S_BUSY, S_LOGIC, S_MENU, S_RUN, S_GUI, S_END, NSPLIT };
+static const char* const kSplit[NSPLIT] = { "gap", "wait", "busy", "logic", "menu", "run", "gui", "end" };
+struct Top {
+    char name[60];
+    float ms;
+    unsigned kb;
+};
+struct Frame {
+    unsigned long long t[NCAT];
+    unsigned n[NCAT];
+    unsigned long long b[NCAT];
+    Top top[3];
+};
+struct Win {
+    double ms[NCAT];
+    double spk[NCAT];
+    unsigned long long n[NCAT];
+    unsigned long long b[NCAT];
+    double split[NSPLIT];
+    double splitSpk[NSPLIT];
+    unsigned frames, spikes, logged;
+    unsigned long long tris, vtx, draws;
+    unsigned trisMax, drawsMax;
+    double cpu[4096];
+    unsigned ncpu;
+    Clock::time_point start;
+};
+static Frame sF{};
+static Frame sBg{}; // pool-thread loads since the last frame end (sBgMu)
+static std::mutex sBgMu;
+static Win sW{};
+static Clock::time_point sFrameStart{}, sTickExit{}, sMark[3]{};
+static double sLogicMs = 0.0;
+static int sTickFrame = 0;
+static double TickMs() {
+    static const double v = [] {
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        return (double)tb.numer / (double)tb.denom / 1e6;
+    }();
+    return v;
+}
+static double Ms(Clock::time_point a, Clock::time_point b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+}
+static bool Set(Clock::time_point t) {
+    return t.time_since_epoch().count() != 0;
+}
+static void TopInsert(Top* top, const char* name, float ms, unsigned kb) {
+    int lo = 0;
+    for (int i = 1; i < 3; i++) {
+        if (top[i].ms < top[lo].ms) {
+            lo = i;
+        }
+    }
+    if (ms <= top[lo].ms) {
+        return;
+    }
+    size_t len = name ? strlen(name) : 0;
+    const char* src = (len > sizeof(top[lo].name) - 1) ? name + (len - (sizeof(top[lo].name) - 1)) : name;
+    snprintf(top[lo].name, sizeof(top[lo].name), "%s", src ? src : "?");
+    top[lo].ms = ms;
+    top[lo].kb = kb;
+}
+// Bounded append into a fixed line buffer (no allocation).
+static void Ap(char* buf, size_t cap, size_t& k, const char* fmt, ...) __attribute__((format(printf, 4, 5)));
+static void Ap(char* buf, size_t cap, size_t& k, const char* fmt, ...) {
+    if (k >= cap - 1) {
+        return;
+    }
+    va_list ap;
+    va_start(ap, fmt);
+    int w = vsnprintf(buf + k, cap - k, fmt, ap);
+    va_end(ap);
+    if (w > 0) {
+        k = std::min(cap - 1, k + (size_t)w);
+    }
+}
+static void AppendTops(char* buf, size_t cap, size_t& k, const Top* top, const char* prefix) {
+    for (int i = 0; i < 3; i++) {
+        if (top[i].ms > 0.0f) {
+            Ap(buf, cap, k, " %s%s:%.1fms:%ukb", prefix, top[i].name, top[i].ms, top[i].kb);
+        }
+    }
+}
+static void ReportWindow(Clock::time_point now) {
+    Win& w = sW;
+    double el = Ms(w.start, now) / 1000.0;
+    if (w.frames > 0) {
+        std::sort(w.cpu, w.cpu + w.ncpu);
+        auto pct = [&](double p) { return w.ncpu ? w.cpu[(size_t)(p * (w.ncpu - 1))] : 0.0; };
+        static char buf[2048];
+        size_t k = 0;
+        Ap(buf, sizeof(buf), k, "SOH_SPKWIN el=%.1f frames=%u spikes=%u logged=%u cpu_ms p50=%.2f p95=%.2f max=%.2f |",
+           el, w.frames, w.spikes, w.logged, pct(0.5), pct(0.95), w.ncpu ? w.cpu[w.ncpu - 1] : 0.0);
+        Ap(buf, sizeof(buf), k, " avg_ms all/spike:");
+        for (int s = 0; s < NSPLIT; s++) {
+            Ap(buf, sizeof(buf), k, " %s=%.2f/%.2f", kSplit[s], w.split[s] / w.frames,
+               w.spikes ? w.splitSpk[s] / w.spikes : 0.0);
+        }
+        Ap(buf, sizeof(buf), k, " | n/ms/spk_ms:");
+        for (int c = 0; c < NCAT; c++) {
+            if (w.n[c] == 0) {
+                continue;
+            }
+            Ap(buf, sizeof(buf), k, " %s=%llu/%.1f/%.1f", kName[c], w.n[c], w.ms[c], w.spk[c]);
+            if (w.b[c] != 0) {
+                Ap(buf, sizeof(buf), k, "/%.1fMB", w.b[c] / 1048576.0);
+            }
+        }
+        Ap(buf, sizeof(buf), k, " | tris_avg=%llu tris_max=%u vtx_avg=%llu draws_avg=%llu draws_max=%u thermal=%d",
+           w.tris / w.frames, w.trisMax, w.vtx / w.frames, w.draws / w.frames, w.drawsMax, SohIos_ThermalState());
+        SPDLOG_INFO("{}", buf);
+    }
+    sW = Win{};
+    sW.start = now;
+}
+} // namespace SohIosSpk
+
+extern "C" unsigned long long SohIos_SpkNow(void) {
+    return gSohIosSpkOn ? mach_absolute_time() : 0ull;
+}
+
+extern "C" void SohIos_SpkAdd(int cat, unsigned long long t0, unsigned long long bytes) {
+    if (t0 == 0ull || cat < 0 || cat >= SohIosSpk::NCAT || !pthread_main_np()) {
+        return;
+    }
+    SohIosSpk::sF.t[cat] += mach_absolute_time() - t0;
+    SohIosSpk::sF.n[cat]++;
+    SohIosSpk::sF.b[cat] += bytes;
+}
+
+// A resource cache miss that was actually loaded (ResourceManager, after
+// overlay 0029's timing block, whose start it reuses). Any thread.
+extern "C" void SohIos_SpkResMs(const char* name, double ms, unsigned long long bytes) {
+    using namespace SohIosSpk;
+    if (!gSohIosSpkOn || ms < 0.0) {
+        return;
+    }
+    unsigned long long ticks = (unsigned long long)(ms / TickMs());
+    if (pthread_main_np()) {
+        sF.t[0] += ticks;
+        sF.n[0]++;
+        sF.b[0] += bytes;
+        TopInsert(sF.top, name, (float)ms, (unsigned)(bytes / 1024));
+    } else {
+        std::lock_guard<std::mutex> lk(sBgMu);
+        sBg.t[2] += ticks;
+        sBg.n[2]++;
+        sBg.b[2] += bytes;
+        TopInsert(sBg.top, name, (float)ms, (unsigned)(bytes / 1024));
+    }
+}
+
+// 0/1/2: StartDraw / Run / EndDraw returned. 3: RunCommands' HandleEvents
+// (the game frame's logic has just run). 4: push_frame's audio wait done
+// (game frame exit).
+extern "C" void SohIos_SpkMark(int which) {
+    using namespace SohIosSpk;
+    if (!gSohIosSpkOn) {
+        return;
+    }
+    auto now = Clock::now();
+    if (which >= 0 && which < 3) {
+        sMark[which] = now;
+    } else if (which == 3) {
+        sLogicMs = Set(sTickExit) ? Ms(sTickExit, now) : 0.0;
+        sTickFrame = 0;
+    } else if (which == 4) {
+        sTickExit = now;
+    }
+}
+
+// Closes one 2D frame record. Called by Fast3dWindow right after
+// Interpreter::EndFrame (so after LUS's pacing sleep).
+extern "C" void SohIos_SpkFrameEnd(void) {
+    using namespace SohIosSpk;
+    static unsigned sPoll = 0;
+    if ((sPoll++ % 60u) == 0u) {
+        int on = CVarGetInteger("gSohIos.SpikeProbe", 1) != 0 ? 1 : 0;
+        if (on != gSohIosSpkOn) {
+            gSohIosSpkOn = on;
+            SPDLOG_INFO("SOH_SPKWIN probe -> {}", on);
+            sF = Frame{};
+            sFrameStart = Clock::time_point{};
+            sTickExit = Clock::time_point{};
+            ReportWindow(Clock::now());
+        }
+    }
+    if (!gSohIosSpkOn) {
+        gSohIosSpkTris = gSohIosSpkVtx = gSohIosSpkDraws = 0;
+        return;
+    }
+    auto now = Clock::now();
+    if (!Set(sW.start)) {
+        sW.start = now;
+    }
+    const auto db = SohIosPace::sDrawBegin, de = SohIosPace::sDrawEnd, sb = SohIosPace::sSleepBegin;
+    bool ok = Set(sFrameStart) && db >= sFrameStart && de >= db && sb >= de && sb <= now && gSoh3DMode == 0;
+    double gap = ok ? Ms(sFrameStart, db) : 0.0;
+    if (ok && gap < 500.0) {
+        double sp[NSPLIT] = {};
+        sp[S_GAP] = gap;
+        sp[S_WAIT] = Ms(db, de);
+        sp[S_BUSY] = Ms(de, sb);
+        sp[S_LOGIC] = sLogicMs;
+        if (sMark[0] >= de && sMark[1] >= sMark[0] && sMark[2] >= sMark[1] && sb >= sMark[2]) {
+            sp[S_MENU] = Ms(de, sMark[0]);
+            sp[S_RUN] = Ms(sMark[0], sMark[1]);
+            sp[S_GUI] = Ms(sMark[1], sMark[2]);
+            sp[S_END] = Ms(sMark[2], sb);
+        }
+        Top bgTop[3] = {};
+        {
+            std::lock_guard<std::mutex> lk(sBgMu);
+            sF.t[2] = sBg.t[2];
+            sF.n[2] = sBg.n[2];
+            sF.b[2] = sBg.b[2];
+            memcpy(bgTop, sBg.top, sizeof(bgTop));
+            sBg = Frame{};
+        }
+        double cpu = sp[S_GAP] + sp[S_BUSY];
+        double period = 1000.0 / (double)std::max(SohIosPace::sFps, 20);
+        bool spike = cpu > period;
+        Win& w = sW;
+        w.frames++;
+        if (w.ncpu < 4096) {
+            w.cpu[w.ncpu++] = cpu;
+        }
+        for (int s = 0; s < NSPLIT; s++) {
+            w.split[s] += sp[s];
+            if (spike) {
+                w.splitSpk[s] += sp[s];
+            }
+        }
+        for (int c = 0; c < NCAT; c++) {
+            double ms = sF.t[c] * TickMs();
+            w.ms[c] += ms;
+            w.n[c] += sF.n[c];
+            w.b[c] += sF.b[c];
+            if (spike) {
+                w.spk[c] += ms;
+            }
+        }
+        w.tris += gSohIosSpkTris;
+        w.vtx += gSohIosSpkVtx;
+        w.draws += gSohIosSpkDraws;
+        w.trisMax = std::max(w.trisMax, gSohIosSpkTris);
+        w.drawsMax = std::max(w.drawsMax, gSohIosSpkDraws);
+        if (spike) {
+            w.spikes++;
+            if (w.logged < 20) {
+                w.logged++;
+                static char buf[1536];
+                size_t k = 0;
+                Ap(buf, sizeof(buf), k,
+                   "SOH_SPIKE cpu=%.1f period=%.1f fi=%d gap=%.1f wait=%.1f busy=%.1f logic=%.1f menu=%.1f run=%.1f "
+                   "gui=%.1f end=%.1f tris=%u vtx=%u draws=%u |",
+                   cpu, period, sTickFrame, sp[S_GAP], sp[S_WAIT], sp[S_BUSY], sp[S_LOGIC], sp[S_MENU], sp[S_RUN],
+                   sp[S_GUI], sp[S_END], gSohIosSpkTris, gSohIosSpkVtx, gSohIosSpkDraws);
+                for (int c = 0; c < NCAT; c++) {
+                    if (sF.n[c] == 0) {
+                        continue;
+                    }
+                    Ap(buf, sizeof(buf), k, " %s=%u/%.2f", kName[c], sF.n[c], sF.t[c] * TickMs());
+                    if (sF.b[c] != 0) {
+                        Ap(buf, sizeof(buf), k, "/%llukb", sF.b[c] / 1024);
+                    }
+                }
+                Ap(buf, sizeof(buf), k, " | top:");
+                AppendTops(buf, sizeof(buf), k, sF.top, "");
+                AppendTops(buf, sizeof(buf), k, bgTop, "bg:");
+                SPDLOG_INFO("{}", buf);
+            }
+        }
+    }
+    sF = Frame{};
+    gSohIosSpkTris = gSohIosSpkVtx = gSohIosSpkDraws = 0;
+    sLogicMs = 0.0;
+    sTickFrame++;
+    // Re-read the clock: the probe's own logging is not charged to the next
+    // frame (SOH_PACE, which is independent, still sees it).
+    sFrameStart = Clock::now();
+    if (Ms(sW.start, sFrameStart) >= 10000.0) {
+        ReportWindow(sFrameStart);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// MENU-PHASE SPLIT (Shipwright 0068 / D-087). Ten marks in the 2D frame:
+//   P  Gui::ImGuiBackendNewFrame, before GfxRenderingAPIMetal::NewFrame
+//   A  ... after it (nextDrawable + SetupScreenFramebuffer + ImGui Metal NewFrame)
+//   B  Gui::ImGuiWMNewFrame, after ImGui_ImplSDL2_NewFrame
+//   C  Gui::DrawMenu entry (ImGui::NewFrame is B..C)
+//   D  Gui::DrawMenu, before the menu bar
+//   E  after the menu bar     F after the port menu     G after the GuiWindows
+//   H  Gui::CalculateGameViewport entry               I  its exit
+// sub-buckets fb (A - drawable acquired), sdl, new, dock, bar, menu, win, end,
+// vp; each with wall AND thread-CPU time; every GuiWindow timed by name.
+namespace SohIosMenu {
+using Clock = std::chrono::steady_clock;
+enum { NMARK = 10 };
+enum { M_FB, M_SDL, M_NEW, M_DOCK, M_BAR, M_MENU, M_WIN, M_END, M_VP, NSUB };
+static const char* const kSub[NSUB] = { "fb", "sdl", "new", "dock", "bar", "menu", "win", "end", "vp" };
+static Clock::time_point sT[NMARK];
+static unsigned long long sC[NMARK];
+static int sNext = 0; // next expected mark; 0 = waiting for P
+struct WinAcc {
+    const char* name;
+    double ms;
+    double maxMs;
+};
+struct Win {
+    unsigned frames, slow, logged;
+    double wall, wallSlow, wallMax, cpu, cpuSlow;
+    double sub[NSUB], subSlow[NSUB], subMax[NSUB];
+    unsigned topCount[NSUB];
+    WinAcc win[64];
+    int nwin;
+    Clock::time_point start;
+};
+static Win sW{};
+static const char* sTopWin = nullptr;
+static double sTopWinMs = 0.0;
+static double TickMs() {
+    static const double v = [] {
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        return (double)tb.numer / (double)tb.denom / 1e6;
+    }();
+    return v;
+}
+static double Ms(Clock::time_point a, Clock::time_point b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+}
+static void Report(Clock::time_point now) {
+    Win& w = sW;
+    if (w.frames > 0) {
+        static char buf[2048];
+        size_t k = 0;
+        auto ap = [&](const char* fmt, auto... a) {
+            if (k < sizeof(buf) - 1) {
+                int n = snprintf(buf + k, sizeof(buf) - k, fmt, a...);
+                if (n > 0) {
+                    k = std::min(sizeof(buf) - 1, k + (size_t)n);
+                }
+            }
+        };
+        double sl = w.slow ? (double)w.slow : 1.0;
+        ap("SOH_MENUWIN el=%.1f frames=%u slow=%u wall avg=%.2f slow=%.2f max=%.2f cpu avg=%.2f slow=%.2f |"
+           " sub all/slow/max:",
+           Ms(w.start, now) / 1000.0, w.frames, w.slow, w.wall / w.frames, w.wallSlow / sl, w.wallMax,
+           w.cpu / w.frames, w.cpuSlow / sl);
+        for (int s = 0; s < NSUB; s++) {
+            ap(" %s=%.2f/%.2f/%.1f", kSub[s], w.sub[s] / w.frames, w.subSlow[s] / sl, w.subMax[s]);
+        }
+        ap(" | slow_top:");
+        for (int s = 0; s < NSUB; s++) {
+            if (w.topCount[s] != 0) {
+                ap(" %s=%u", kSub[s], w.topCount[s]);
+            }
+        }
+        ap(" | wins:");
+        for (int r = 0; r < 4; r++) {
+            int best = -1;
+            for (int i = 0; i < w.nwin; i++) {
+                if (w.win[i].ms >= 0.0 && (best < 0 || w.win[i].ms > w.win[best].ms)) {
+                    best = i;
+                }
+            }
+            if (best < 0 || w.win[best].ms <= 0.0) {
+                break;
+            }
+            ap(" %s=%.1f/%.2f", w.win[best].name, w.win[best].ms, w.win[best].maxMs);
+            w.win[best].ms = -1.0; // consumed (the window is reset below)
+        }
+        SPDLOG_INFO("{}", buf);
+    }
+    sW = Win{};
+    sW.start = now;
+}
+static void Finish() {
+    Clock::time_point de = SohIosPace::sDrawEnd;
+    double sub[NSUB], cpu[NSUB];
+    sub[M_FB] = (de <= sT[1] && Ms(de, sT[1]) < 1000.0) ? Ms(de, sT[1]) : 0.0;
+    cpu[M_FB] = (sC[1] - sC[0]) / 1e6;
+    for (int s = 1; s < NSUB; s++) {
+        sub[s] = Ms(sT[s], sT[s + 1]);
+        cpu[s] = (sC[s + 1] - sC[s]) / 1e6;
+    }
+    double wall = 0.0, tcpu = 0.0;
+    int top = 0;
+    for (int s = 0; s < NSUB; s++) {
+        wall += sub[s];
+        tcpu += cpu[s];
+        if (sub[s] > sub[top]) {
+            top = s;
+        }
+    }
+    Win& w = sW;
+    if (w.start.time_since_epoch().count() == 0) {
+        w.start = sT[9];
+    }
+    bool slow = wall >= 4.0;
+    w.frames++;
+    w.wall += wall;
+    w.cpu += tcpu;
+    w.wallMax = std::max(w.wallMax, wall);
+    for (int s = 0; s < NSUB; s++) {
+        w.sub[s] += sub[s];
+        w.subMax[s] = std::max(w.subMax[s], sub[s]);
+        if (slow) {
+            w.subSlow[s] += sub[s];
+        }
+    }
+    if (slow) {
+        w.slow++;
+        w.wallSlow += wall;
+        w.cpuSlow += tcpu;
+        w.topCount[top]++;
+        if (w.logged < 20) {
+            w.logged++;
+            static char buf[768];
+            size_t k = 0;
+            int n = snprintf(buf, sizeof(buf), "SOH_MSLOW wall=%.2f cpu=%.2f top=%s |", wall, tcpu, kSub[top]);
+            k = n > 0 ? std::min(sizeof(buf) - 1, (size_t)n) : 0;
+            for (int s = 0; s < NSUB && k < sizeof(buf) - 1; s++) {
+                n = snprintf(buf + k, sizeof(buf) - k, " %s=%.2f/%.2f", kSub[s], sub[s], cpu[s]);
+                k = n > 0 ? std::min(sizeof(buf) - 1, k + (size_t)n) : k;
+            }
+            if (k < sizeof(buf) - 1) {
+                snprintf(buf + k, sizeof(buf) - k, " | win_top=%s:%.2f", sTopWin ? sTopWin : "-", sTopWinMs);
+            }
+            SPDLOG_INFO("{}", buf);
+        }
+    }
+    if (Ms(w.start, sT[9]) >= 10000.0) {
+        Report(sT[9]);
+    }
+}
