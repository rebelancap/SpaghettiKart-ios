+extern "C" void SohIos_MenuWin(const char* name, unsigned long long t0) {
+    using namespace SohIosMenu;
+    if (t0 == 0ull || name == nullptr || sNext == 0) {
+        return;
+    }
+    double ms = (mach_absolute_time() - t0) * TickMs();
+    if (ms > sTopWinMs) {
+        sTopWinMs = ms;
+        sTopWin = name;
+    }
+    Win& w = sW;
+    for (int i = 0; i < w.nwin; i++) {
+        if (w.win[i].name == name) {
+            w.win[i].ms += ms;
+            w.win[i].maxMs = std::max(w.win[i].maxMs, ms);
+            return;
+        }
+    }
+    if (w.nwin < 64) {
+        w.win[w.nwin++] = WinAcc{ name, ms, ms };
+    }
+}
