+/* The bucket, lifted out of render_track_sections verbatim so the rear
+ * camera is classified by exactly the code that classifies the forward
+ * one -- including the mirror-mode swap of EAST and WEST. */
+static s16 SohVRTrackDirection(u16 sohRot) {
+    if (sohRot < 0x2000) {
+        return SOUTH;
+    } else if (sohRot < 0x6000) {
+        return gIsMirrorMode ? WEST : EAST;
+    } else if (sohRot < 0xA000) {
+        return NORTH;
+    } else if (sohRot < 0xE000) {
+        return gIsMirrorMode ? EAST : WEST;
+    }
+    return SOUTH;
+}
+static void SohVREmitNoOp(u32 sohTagId) {
+    Gfx* sohTag = gDisplayListHead++;
+    sohTag->words.w0 = (uintptr_t) ((G_NOOP << 24) | (sohTagId << 16));
+    sohTag->words.w1 = 0;
+}
+#endif
