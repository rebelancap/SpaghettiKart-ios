+#ifdef __IOS__
+#include <math.h>
+// SOH_IOS (overlay 0045): live camera basis for stereoscopic 3D (0044).
+// FILE-scope extern "C" — block-scope externs namespace-mangle in C++.
+extern "C" {
+extern volatile float gSoh3DCamDist, gSoh3DCamP00;
+// rev5 (R16-C): the GAME's own projection aspect. The rear pane's
+// framebuffer was sized off the EYE extent, on a comment claiming the
+// two matched; they do not (sim eye 1.778, device 1.246, game 1.3333).
+extern volatile float gSoh3DCamAspect;
+extern volatile float gSoh3DCamRight[3], gSoh3DCamFwd[3], gSoh3DCamEye[3];
+// rev6 (R17-A item 1): the PREVIOUS game frame's camera eye. The seat is
+// composed from a pose exported once per game frame while every object in
+// the list is drawn at FrameInterpolation's sub-frame t; this is the other
+// end of the segment the seat has to be interpolated along.
+extern volatile float gSoh3DCamEyePrev[3];
+// rev7 (R17-C): the seed. See the patch header.
+extern volatile unsigned int gSohVRGameFrame, gSohVRSeatSeeds;
+extern volatile float gSohVRSeatSeedFault;
+}
+// rev7: per-TU, and deliberately so -- a GameCamera <-> TourCamera
+// hand-over is a shot cut, which is exactly a discontinuity.
+static unsigned int sSoh3DCamLastFrame = 0u;
+static int sSoh3DCamSeeded = 0;
+static void Soh3DExportCameraBasis(Camera* sohCam, float sohAspect) {
+    if (sohCam == NULL || sohCam->playerId != 0) {
+        return; // player 1 only — split-screen order is winner-dependent
+    }
+    float sohDx = sohCam->lookAt[0] - sohCam->pos[0];
+    float sohDy = sohCam->lookAt[1] - sohCam->pos[1];
+    float sohDz = sohCam->lookAt[2] - sohCam->pos[2];
+    float sohDist = sqrtf(sohDx * sohDx + sohDy * sohDy + sohDz * sohDz);
+    if (sohDist <= 0.0f) {
+        return;
+    }
+    float sohFx = sohDx / sohDist, sohFy = sohDy / sohDist, sohFz = sohDz / sohDist;
+    float sohRx = sohFy * sohCam->up[2] - sohFz * sohCam->up[1];
+    float sohRy = sohFz * sohCam->up[0] - sohFx * sohCam->up[2];
+    float sohRz = sohFx * sohCam->up[1] - sohFy * sohCam->up[0];
+    float sohRl = sqrtf(sohRx * sohRx + sohRy * sohRy + sohRz * sohRz);
+    if (sohRl <= 1e-4f) {
+        return; // camera looking straight along up — keep last basis
+    }
+    gSoh3DCamRight[0] = sohRx / sohRl;
+    gSoh3DCamRight[1] = sohRy / sohRl;
+    gSoh3DCamRight[2] = sohRz / sohRl;
+    gSoh3DCamFwd[0] = sohFx;
+    gSoh3DCamFwd[1] = sohFy;
+    gSoh3DCamFwd[2] = sohFz;
+    // rev6: prev, before it is overwritten. rev7: SEEDED (prev = cur) on the
+    // first export of the process and after any game-frame discontinuity --
+    // otherwise the pose from before a menu or a fly-by is differenced
+    // against this one and spent as a one-frame seat nudge.
+    const unsigned int sohFr = gSohVRGameFrame;
+    const int sohDisc = (!sSoh3DCamSeeded) || (sohFr != sSoh3DCamLastFrame + 1u);
+    if (sohDisc && gSohVRSeatSeedFault <= 0.0f) {
+        gSoh3DCamEyePrev[0] = sohCam->pos[0];
+        gSoh3DCamEyePrev[1] = sohCam->pos[1];
+        gSoh3DCamEyePrev[2] = sohCam->pos[2];
+        gSohVRSeatSeeds = gSohVRSeatSeeds + 1u;
+    } else if (sohDisc && gSohVRSeatSeedFault > 1.0f) {
+        gSoh3DCamEyePrev[0] = sohCam->pos[0] + gSohVRSeatSeedFault;
+        gSoh3DCamEyePrev[1] = sohCam->pos[1];
+        gSoh3DCamEyePrev[2] = sohCam->pos[2];
+    } else {
+        gSoh3DCamEyePrev[0] = gSoh3DCamEye[0];
+        gSoh3DCamEyePrev[1] = gSoh3DCamEye[1];
+        gSoh3DCamEyePrev[2] = gSoh3DCamEye[2];
+    }
+    sSoh3DCamLastFrame = sohFr;
+    sSoh3DCamSeeded = 1;
+    gSoh3DCamEye[0] = sohCam->pos[0];
+    gSoh3DCamEye[1] = sohCam->pos[1];
+    gSoh3DCamEye[2] = sohCam->pos[2];
+    float sohHalfFovX = tanf(sohCam->fieldOfView * 0.5f * (3.14159265f / 180.0f)) * sohAspect;
+    gSoh3DCamP00 = (sohHalfFovX > 1e-4f) ? (1.0f / sohHalfFovX) : 1.0f;
+    gSoh3DCamDist = sohDist;
+    gSoh3DCamAspect = sohAspect;
+}
+#endif
+
+#ifdef __IOS__
+// SOH_IOS (overlay 0045 rev2): player-1 kart pose for the VR first-person
+// seat. MK64's camera lookAt is a target AHEAD of the kart, so the camera
+// basis alone cannot place a driver's head; this is the kart itself.
+extern "C" {
+extern volatile float gSohVRKartPos[3], gSohVRKartVel[3];
+// SOH_IOS (overlay 0045 rev6, VR R17-A item 1): the kart position exported
+// for the PREVIOUS game frame, published inside this same seqlock so a
+// consumer gets a coherent pair or neither. See the patch header.
+extern volatile float gSohVRKartPosPrev[3];
+extern volatile int gSohVRKartYawBam, gSohVRKartValid;
+// SOH_IOS (overlay 0045 rev4, VR R16-A): the SEQLOCK. rev2 published this
+// pose as five independent stores guarded by a flag that was CLEARED at
+// the head of every game frame and re-raised here, mid-frame -- so a
+// 90-120 Hz consumer reading in the gap was told there was no kart while a
+// kart was being raced, and composed the world from the chase camera for
+// one frame. gSohVRKartSeq is odd while this function is writing and even
+// when the snapshot is whole; gSohVRKartFrame names the game frame it
+// belongs to, and the consumer expresses "no kart" as an AGE instead of a
+// hole. It also closes a genuine torn read: three position floats stored
+// non-atomically and consumed at four times this rate.
+extern volatile unsigned int gSohVRKartSeq, gSohVRKartFrame, gSohVRGameFrame;
+// R16-A FAL-B's RED CONTROL: skip the export for N CONSECUTIVE game frames
+// out of every 16, so the staleness bound can be shown HOLDING for a burst
+// no longer than the bound and LETTING GO for one that is. Consecutive is
+// the point: a single missed frame is what the old mid-frame clear caused
+// and the bound absorbs it by design, so a one-in-N fault could never
+// discriminate. 0 = off, which is every shipped configuration.
+extern volatile int gSohVRKartHoleFault;
+// rev7 (R17-C): the seed. See the patch header.
+extern volatile unsigned int gSohVRSeatSeeds;
+extern volatile float gSohVRSeatSeedFault;
+}
+static unsigned int sSohVRKartLastFrame = 0u;
+static int sSohVRKartSeeded = 0;
+static void SohVRExportKartPose(Camera* sohCam) {
+    if (sohCam == NULL || sohCam->playerId != 0 || gPlayerOne == NULL) {
+        return;
+    }
+    if (gSohVRKartHoleFault > 0 &&
+        (gSohVRGameFrame % 16u) < (unsigned int) gSohVRKartHoleFault) {
+        return; /* R16-A red control: a deliberate burst of missed frames */
+    }
+    Player* sohP = gPlayerOne;
+    gSohVRKartSeq = gSohVRKartSeq + 1u; /* odd: write in progress */
+    __sync_synchronize();
+    /* rev6: prev, before overwriting. rev7: SEEDED (prev = cur) whenever this
+     * export is the first of the process, the first after validity went
+     * 0 -> 1, or the first after a game-frame discontinuity -- a menu, a
+     * fly-by, a pause, a race restart or the R16-A hole fault. Without it
+     * the grid pose is differenced against the pose the LAST race ended on,
+     * and a finish line is near the grid, so the 400-unit teleport heuristic
+     * in 0044 rev13 does not catch it. */
+    const unsigned int sohKFr = gSohVRGameFrame;
+    const int sohKDisc = (!sSohVRKartSeeded) || (!gSohVRKartValid) ||
+                         (sohKFr != sSohVRKartLastFrame + 1u);
+    if (sohKDisc && gSohVRSeatSeedFault <= 0.0f) {
+        gSohVRKartPosPrev[0] = sohP->pos[0];
+        gSohVRKartPosPrev[1] = sohP->pos[1];
+        gSohVRKartPosPrev[2] = sohP->pos[2];
+        gSohVRSeatSeeds = gSohVRSeatSeeds + 1u;
+    } else if (sohKDisc && gSohVRSeatSeedFault > 1.0f) {
+        /* the fault injector: a stale prev of a KNOWN size */
+        gSohVRKartPosPrev[0] = sohP->pos[0] + gSohVRSeatSeedFault;
+        gSohVRKartPosPrev[1] = sohP->pos[1];
+        gSohVRKartPosPrev[2] = sohP->pos[2];
+    } else {
+        gSohVRKartPosPrev[0] = gSohVRKartPos[0];
+        gSohVRKartPosPrev[1] = gSohVRKartPos[1];
+        gSohVRKartPosPrev[2] = gSohVRKartPos[2];
+    }
+    sSohVRKartLastFrame = sohKFr;
+    sSohVRKartSeeded = 1;
+    gSohVRKartPos[0] = sohP->pos[0];
+    gSohVRKartPos[1] = sohP->pos[1];
+    gSohVRKartPos[2] = sohP->pos[2];
+    gSohVRKartVel[0] = sohP->velocity[0];
+    gSohVRKartVel[1] = sohP->velocity[1];
+    gSohVRKartVel[2] = sohP->velocity[2];
+    // REV3 (R8): NEGATED. `player->rotation[1]` does NOT share the
+    // camera's atan2s convention — rev2's citation (camera.c:1281) is a
+    // one-off STAGING camera assignment, not the racing convention, and
+    // it is the whole of the user's inverted-orbit steering bug.
+    // GROUND TRUTH, from the physics rather than from any angle:
+    // func_8002AE38 (src/player_controller.c:1115) integrates the kart's
+    // own position with
+    //     x += sins(-player->rotation[1]) * speed;
+    //     z += coss(-player->rotation[1]) * speed;
+    // and calculate_orientation_matrix's rot-Y (racing/math_util.c:616)
+    // maps the kart model's +Z to (-sin(rot1), 0, cos(rot1)) — the same
+    // vector. So the kart's world forward is (sins(-rot1), coss(-rot1)),
+    // while atan2s(x, z) (racing/math_util.c:900) returns the angle whose
+    // forward is (+sin, +cos). The two conventions are MIRRORED.
+    // Everything downstream of this export (the shell's A composition,
+    // gSohVREyeYawBam's atan2f(x, z) re-key, 0051's sky/billboard
+    // re-key) speaks the atan2s convention, so the conversion happens
+    // ONCE, here, at the boundary.
+    gSohVRKartYawBam = (int) (s16) (-(s32) (s16) sohP->rotation[1]);
+    gSohVRKartFrame = gSohVRGameFrame; /* rev4: the frame this belongs to */
+    __sync_synchronize();
+    gSohVRKartSeq = gSohVRKartSeq + 1u; /* even: the snapshot is whole */
+    gSohVRKartValid = 1;
+}
+#endif
