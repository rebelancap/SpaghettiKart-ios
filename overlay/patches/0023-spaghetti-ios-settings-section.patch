     if (CVarGetInteger("gMatchRefreshRate", 0)) {
+#ifdef __IOS__
+        // SOH_IOS (overlay 0023 rev4): battery-saver cap — gSohIos.MaxFps
+        // holds a literal fps VALUE (60/90/120; reference semantics — the
+        // shell migration converts legacy 0/1 indices). Guard maps any
+        // straggler index anyway: <30 can only be legacy.
+        uint32_t sohIosCap = (uint32_t)CVarGetInteger("gSohIos.MaxFps", 120);
+        if (sohIosCap < 30) {
+            sohIosCap = (sohIosCap == 0) ? 60 : 120;
+        }
+        uint32_t sohIosRate = Ship::Context::GetInstance()->GetWindow()->GetCurrentRefreshRate();
+        return sohIosRate < sohIosCap ? sohIosRate : sohIosCap;
+#else
         return Ship::Context::GetInstance()->GetWindow()->GetCurrentRefreshRate();
+#endif
 
     } else if (CVarGetInteger("gVsyncEnabled", 1) ||
                !Ship::Context::GetInstance()->GetWindow()->CanDisableVerticalSync()) {
