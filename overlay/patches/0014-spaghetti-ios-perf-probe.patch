+namespace SohIosPerf {
+struct Probe {
+    std::vector<double> frameMs;
+    std::vector<double> engMs;
+    std::vector<double> gpuMs; // cached per-present GPU pass time (0027)
+    uint64_t ticks = 0;      // process_game_tick calls (60 Hz racing)
+    uint64_t engFrames = 0;  // engine iterations (30 Hz)
+    uint32_t hudFrames = 0;  // rolling 1 s window for the shell's perf HUD
+    float hudFps = 0.0f;
+    // VR harness (spec D11 pacing triple): the 10 s SOH_PERF line is too
+    // coarse for a live dump, so engine_fps/tick_tps also ride a rolling 1 s
+    // window readable at any instant via SohIos_PacingStats.
+    uint64_t pacEng = 0, pacTick = 0;
+    float pacEngFps = 0.0f, pacTickTps = 0.0f;
+    std::chrono::steady_clock::time_point pacWindowStart = std::chrono::steady_clock::now();
+    std::chrono::steady_clock::time_point hudWindowStart = std::chrono::steady_clock::now();
+    std::chrono::steady_clock::time_point lastFrame{};
+    std::chrono::steady_clock::time_point lastReport = std::chrono::steady_clock::now();
+    void OnFrame(double engineMs) {
+        engMs.push_back(engineMs);
+        gpuMs.push_back((double)gSohIosGpuMs);
+        auto now = std::chrono::steady_clock::now();
+        hudFrames++;
+        double hudEl = std::chrono::duration<double>(now - hudWindowStart).count();
+        if (hudEl >= 1.0) {
+            hudFps = (float)(hudFrames / hudEl);
+            hudFrames = 0;
+            hudWindowStart = now;
+        }
+        if (lastFrame.time_since_epoch().count() != 0) {
+            frameMs.push_back(std::chrono::duration<double, std::milli>(now - lastFrame).count());
+        }
+        lastFrame = now;
+    }
+    void OnEngineFrame() {
+        engFrames++;
+        auto now = std::chrono::steady_clock::now();
+        // Rolling 1 s pacing window FIRST — it must keep updating even when
+        // the 10 s report below early-returns.
+        pacEng++;
+        double pacEl = std::chrono::duration<double>(now - pacWindowStart).count();
+        if (pacEl >= 1.0) {
+            pacEngFps = (float)(pacEng / pacEl);
+            pacTickTps = (float)(pacTick / pacEl);
+            pacEng = 0;
+            pacTick = 0;
+            pacWindowStart = now;
+        }
+        double el = std::chrono::duration<double>(now - lastReport).count();
+        if (el < 10.0 || frameMs.size() < 8 || engMs.size() < 8) {
+            return;
+        }
+        std::sort(frameMs.begin(), frameMs.end());
+        std::sort(engMs.begin(), engMs.end());
+        std::sort(gpuMs.begin(), gpuMs.end());
+        auto pct = [](std::vector<double>& v, double p) { return v[(size_t)(p * (v.size() - 1))]; };
+        // Full attribution field set (2ship convention): wall spike +
+        // high up_ms -> upload path; + high load_ms -> loader; both ~0 ->
+        // scene/actor init. aud_min 0 = audio underrun.
+        int32_t audMin = sSohIosAudMinBuffered.exchange(INT32_MAX);
+        int32_t audMax = sSohIosAudMaxBuffered.exchange(-1);
+        float loadMs = 0, upMs = 0, libMs = 0, psoMs = 0;
+        unsigned int loadN = 0, upN = 0, libN = 0, psoN = 0;
+        SohIos_LoadStats(&loadMs, &loadN);
+        SohIos_UploadStats(&upMs, &upN);
+        SohIos_LibWindowStats(&libMs, &libN);
+        SohIos_PsoWindowStats(&psoMs, &psoN);
+        SPDLOG_INFO("SOH_PERF wall_ms p50={:.2f} p95={:.2f} p99={:.2f} max={:.2f} "
+                    "eng_ms p50={:.2f} p95={:.2f} gpu_ms p50={:.2f} p95={:.2f} n={} fps={:.1f} "
+                    "eng_fps={:.2f} sim_tps={:.2f} aud_min={} aud_max={} load_ms={:.1f} loads={} "
+                    "up_ms={:.1f} ups={} lib_ms={:.1f} lib_n={} pso_ms={:.1f} pso_n={} mem_mb={} thermal={}",
+                    pct(frameMs, 0.5), pct(frameMs, 0.95), pct(frameMs, 0.99), frameMs.back(),
+                    pct(engMs, 0.5), pct(engMs, 0.95), pct(gpuMs, 0.5), pct(gpuMs, 0.95),
+                    frameMs.size(), frameMs.size() / el,
+                    engFrames / el, ticks / el,
+                    audMin == INT32_MAX ? -1 : audMin, audMax, loadMs, loadN,
+                    upMs, upN, libMs, libN, psoMs, psoN, SohIos_MemFootprintMB(), SohIos_ThermalState());
+        frameMs.clear();
+        engMs.clear();
+        gpuMs.clear();
+        ticks = 0;
+        engFrames = 0;
+        lastReport = now;
+    }
+};
+static Probe gPerfProbe;
+} // namespace SohIosPerf
+extern "C" void SohIosPerf_OnGameTick(void) {
+    SohIosPerf::gPerfProbe.ticks++;
+    SohIosPerf::gPerfProbe.pacTick++;
+}
+// Rolling 1-second fps for the shell's performance HUD (SYNC WAVE 1).
+extern "C" void SohIos_HudStats(float* fps) {
+    *fps = SohIosPerf::gPerfProbe.hudFps;
+}
+// VR harness (spec D11): live rolling engine_fps / tick_tps. Two thirds of
+// the pacing triple; the shell's immersive loop owns present cadence.
+extern "C" void SohIos_PacingStats(float* engFps, float* tickTps) {
+    if (engFps != nullptr) {
+        *engFps = SohIosPerf::gPerfProbe.pacEngFps;
+    }
+    if (tickTps != nullptr) {
+        *tickTps = SohIosPerf::gPerfProbe.pacTickTps;
+    }
+}
+#endif
