+// SOH_IOS_PERF (overlay 0014): frame/tick cadence probe (reference 0008
+// body). wall_ms = interval between consecutive presents; eng_ms = time
+// inside DrawAndRunGraphicsCommands. BOTH include in-present blocking:
+// wall~=eng means blocked-inside (GPU/pacing), wall>>eng means CPU outside.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
