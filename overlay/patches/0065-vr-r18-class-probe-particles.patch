+#ifdef __IOS__
+// SOH_IOS (overlay 0065, VR R18-A): the class probe's particle brackets
+// (dev only; see the patch header and overlay 0044 rev15).
+extern volatile int gSohVRClassProbe;
+static void sohvr_cp_part_tag(int sohBegin, int sohCls, int sohKey) {
+    Gfx* sohTag = gDisplayListHead++;
+    sohTag->words.w0 = (uintptr_t) ((G_NOOP << 24) | ((sohBegin ? 0x70 : 0x71) << 16) |
+                                    ((sohCls & 0xF) << 12) | (sohKey & 0xFFF));
+    sohTag->words.w1 = 0;
+}
+#define SOHVR_CP_PART_OPEN(pool, slot)                                                       \
+    do {                                                                                     \
+        if (gSohVRClassProbe) {                                                              \
+            sohvr_cp_part_tag(1, (playerId == 0 && screenId == 0) ? 4 : 7,                   \
+                              (((playerId) & 0xF) << 8) | (((pool) & 0xF) << 4) | ((slot) & 0xF)); \
+        }                                                                                    \
+    } while (0)
+#define SOHVR_CP_PART_CLOSE()                                                                \
+    do {                                                                                     \
+        if (gSohVRClassProbe) {                                                              \
+            sohvr_cp_part_tag(0, 0, 0);                                                      \
+        }                                                                                    \
+    } while (0)
+#endif
